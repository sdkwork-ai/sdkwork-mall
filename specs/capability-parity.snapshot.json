      ],
      "id": "account.login",
      "reason": "PC and H5 delegate login to the shared IAM auth-gate routes."
    },
    {
      "absentOn": [
        "pc"
      ],
      "id": "buyer.im-chat",
      "reason": "Blocked upstream, not deferred: sdkwork-im-app-sdk currently generates notifications plus a thin chat surface (knowledgebase/archive) only - no conversation list and no message send. The mobile roots reach the federation chat plane through their own transport, while the PC root forbids raw HTTP in capability packages (gate: mall PC active packages avoid raw HTTP transport), so PC chat waits for the generated app SDK to expose conversations and messages."
    },
    {
      "absentOn": [
        "pc"
      ],
