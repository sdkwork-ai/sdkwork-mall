page {
  background: #f4f5f7;
  color: #1f2937;
  font-size: 28rpx;
}

.mp-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 0 20rpx 0;
}

.mp-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.mp-muted {
  color: #6b7280;
  font-size: 24rpx;
}

/* ── shared building blocks ── */
.mp-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 0 20rpx 0;
  padding: 24rpx;
}

.mp-card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.mp-flex {
  display: flex;
  align-items: center;
}

.mp-flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mp-price {
  color: #e93b3d;
  font-weight: 700;
}

.mp-price::first-letter {
  font-size: 0.8em;
}

.mp-btn {
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  line-height: 1.5;
  text-align: center;
}

.mp-btn-primary {
  background: #e93b3d;
  color: #fff;
}

.mp-btn-primary[disabled] {
  background: #fca5a5;
  color: #fff;
}

.mp-btn-ghost {
  background: #fff;
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.mp-btn-plain {
  background: #fef2f2;
  color: #e93b3d;
}

.mp-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.mp-loading {
  padding: 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.mp-error {
  margin: 0 0 20rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 24rpx;
}

.mp-toast {
  position: fixed;
  left: 50%;
  bottom: 160rpx;
  transform: translateX(-50%);
  background: rgba(17, 24, 39, 0.85);
  color: #fff;
  border-radius: 12rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  z-index: 99;
}

/* product cards */
.mp-product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0;
}

.mp-product-card {
  width: 48.6%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.mp-product-image {
  width: 100%;
  height: 330rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 40rpx;
}

.mp-product-image image {
  width: 100%;
  height: 100%;
}

.mp-product-body {
  padding: 16rpx 20rpx 20rpx;
}

.mp-product-title {
  font-size: 26rpx;
  color: #1f2937;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  min-height: 72rpx;
}

.mp-product-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.mp-product-sales {
  color: #9ca3af;
  font-size: 22rpx;
}

/* rows */
.mp-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

/* form */
.mp-field {
  display: block;
  margin-bottom: 24rpx;
}

.mp-field-label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.mp-field input,
.mp-field textarea,
.mp-field select {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
}

/* 错误态内的恢复入口：与错误文案同一行，右对齐 */
.mp-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mp-error-retry {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}

/* ==========================================================================
   Visual polish layer (2026-11)
   --------------------------------------------------------------------------
   Shared radius/elevation/motion tokens plus surface refinements for the
   primitives every page reuses. Appended as a trailing layer so individual
   page styles stay untouched.
   ========================================================================== */
page {
  --mp-radius-sm: 12rpx;
  --mp-radius-md: 22rpx;
  --mp-radius-lg: 30rpx;
  --mp-bg: #f5f6f8;
  --mp-panel: #ffffff;
  --mp-border: #eceef2;
  --mp-text: #111827;
  --mp-muted: #6b7280;
  --mp-primary: #e93b3d;
  --mp-primary-soft: #fef2f2;
  --mp-shadow-1: 0 4rpx 16rpx rgba(17, 24, 39, 0.05),
    0 16rpx 40rpx -28rpx rgba(17, 24, 39, 0.32);
  --mp-shadow-2: 0 10rpx 32rpx rgba(17, 24, 39, 0.12);
  background: var(--mp-bg);
  color: var(--mp-text);
  -webkit-font-smoothing: antialiased;
}

/* Mini-program buttons keep the native border; drop it for a flat surface. */
button::after {
  border: 0;
}

.mp-card,
.mp-section {
  background: var(--mp-panel);
  border: 1rpx solid var(--mp-border);
  border-radius: var(--mp-radius-md);
  box-shadow: var(--mp-shadow-1);
  padding: 28rpx;
}

.mp-card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.mp-card-title::before {
  content: "";
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #f43f5e, var(--mp-primary));
}

.mp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: transform 0.12s ease, opacity 0.2s ease;
}

.mp-btn-primary {
  background: linear-gradient(135deg, #f43f5e, var(--mp-primary));
  color: #fff;
  box-shadow: 0 12rpx 28rpx -14rpx rgba(233, 59, 61, 0.9);
}

.mp-btn-primary[disabled] {
  background: #fca5a5;
  box-shadow: none;
}

.mp-btn-ghost {
  background: var(--mp-panel);
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.mp-btn-plain {
  background: var(--mp-primary-soft);
  color: var(--mp-primary);
}

.mp-product-card {
  border-radius: var(--mp-radius-md);
  box-shadow: var(--mp-shadow-1);
  border: 1rpx solid var(--mp-border);
}

.mp-product-image {
  border-radius: var(--mp-radius-md) var(--mp-radius-md) 0 0;
}

.mp-row {
  background: var(--mp-panel);
  border-bottom: 1rpx solid var(--mp-border);
}

.mp-row:last-child {
  border-bottom: 0;
}

.mp-field input,
.mp-field textarea,
.mp-field select {
  border-radius: var(--mp-radius-sm);
  border-color: var(--mp-border);
  background: #fbfbfd;
}

.mp-empty {
  padding: 120rpx 48rpx;
  color: #9aa1ac;
  font-size: 26rpx;
  line-height: 1.6;
}

/* Loading text becomes a shimmer skeleton instead of a bare sentence. */
@keyframes mp-shimmer {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}

.mp-loading {
  color: transparent;
  min-height: 120rpx;
  border-radius: var(--mp-radius-md);
  background: linear-gradient(90deg, #eef1f5 25%, #f8fafc 37%, #eef1f5 63%);
  background-size: 200% 100%;
  animation: mp-shimmer 1.4s linear infinite;
}

.mp-error {
  border: 1rpx solid #fecaca;
  border-radius: var(--mp-radius-sm);
  background: #fef2f2;
  color: #b91c1c;
}

.mp-toast {
  border-radius: var(--mp-radius-sm);
  box-shadow: var(--mp-shadow-2);
}