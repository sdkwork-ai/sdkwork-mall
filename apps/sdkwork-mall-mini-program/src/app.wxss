page {
  background: #f4f5f7;
  color: #1f2937;
  font-size: 28rpx;
}

.mp-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}

.mp-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.mp-muted {
  color: #6b7280;
  font-size: 24rpx;
}

/* ── shared building blocks ── */
.mp-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.mp-card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.mp-flex {
  display: flex;
  align-items: center;
}

.mp-flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mp-price {
  color: #e93b3d;
  font-weight: 700;
}

.mp-price::first-letter {
  font-size: 0.8em;
}

.mp-btn {
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  line-height: 1.5;
  text-align: center;
}

.mp-btn-primary {
  background: #e93b3d;
  color: #fff;
}

.mp-btn-primary[disabled] {
  background: #fca5a5;
  color: #fff;
}

.mp-btn-ghost {
  background: #fff;
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.mp-btn-plain {
  background: #fef2f2;
  color: #e93b3d;
}

.mp-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.mp-loading {
  padding: 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.mp-error {
  margin: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 24rpx;
}

.mp-toast {
  position: fixed;
  left: 50%;
  bottom: 160rpx;
  transform: translateX(-50%);
  background: rgba(17, 24, 39, 0.85);
  color: #fff;
  border-radius: 12rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  z-index: 99;
}

/* product cards */
.mp-product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 20rpx;
}

.mp-product-card {
  width: 48.6%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.mp-product-image {
  width: 100%;
  height: 330rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 40rpx;
}

.mp-product-image image {
  width: 100%;
  height: 100%;
}

.mp-product-body {
  padding: 16rpx 20rpx 20rpx;
}

.mp-product-title {
  font-size: 26rpx;
  color: #1f2937;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  min-height: 72rpx;
}

.mp-product-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.mp-product-sales {
  color: #9ca3af;
  font-size: 22rpx;
}

/* rows */
.mp-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

/* form */
.mp-field {
  display: block;
  margin-bottom: 24rpx;
}

.mp-field-label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.mp-field input,
.mp-field textarea,
.mp-field select {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
}
