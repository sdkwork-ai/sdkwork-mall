.activity-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.activity-upcoming {
  opacity: 0.75;
}

.activity-ended {
  opacity: 0.5;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 700;
}

.activity-tag {
  font-size: 22rpx;
  color: #e93b3d;
  border: 1rpx solid #fca5a5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.activity-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
