<view class="page-security">
  <view wx:if="{{loading}}" class="mp-loading">{{labels.loading}}</view>

  <block wx:if="{{!loading}}">
    <view wx:if="{{!loggedIn}}" class="mp-card">
      <view class="mp-empty">{{labels.loginFirst}}</view>
      <view class="security-actions">
        <button class="mp-btn mp-btn-primary" bindtap="goLogin">{{labels.loginNow}}</button>
      </view>
    </view>

    <block wx:else>
      <view wx:if="{{error}}" class="mp-error">
        <text>{{error}}</text>
        <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">重试</button>
      </view>

      <view class="mp-card">
        <view class="mp-card-title">{{labels.loginInfoTitle}}</view>
        <view class="security-row" wx:for="{{rows}}" wx:key="label">
          <text class="security-label">{{item.label}}</text>
          <text class="security-value">{{item.value}}</text>
        </view>
      </view>

      <view class="mp-card">
        <view class="mp-card-title">{{labels.securityTitle}}</view>

        <view class="security-row" bindtap="togglePassword">
          <text class="security-label">{{labels.passwordTitle}}</text>
          <text class="mp-muted">{{labels.passwordHint}} ›</text>
        </view>

        <view wx:if="{{passwordOpen}}" class="security-password-form">
          <input
            class="security-input"
            password
            placeholder="{{labels.oldPassword}}"
            value="{{oldPassword}}"
            data-field="oldPassword"
            bindinput="onPasswordInput"
          />
          <input
            class="security-input"
            password
            placeholder="{{labels.newPassword}}"
            value="{{newPassword}}"
            data-field="newPassword"
            bindinput="onPasswordInput"
          />
          <input
            class="security-input"
            password
            placeholder="{{labels.confirmPassword}}"
            value="{{confirmPassword}}"
            data-field="confirmPassword"
            bindinput="onPasswordInput"
          />
          <view wx:if="{{formError}}" class="security-form-error">{{formError}}</view>
          <view class="security-actions">
            <button class="mp-btn mp-btn-ghost" bindtap="togglePassword">{{labels.cancel}}</button>
            <button class="mp-btn mp-btn-primary" disabled="{{saving}}" bindtap="submitPassword">
              {{saving ? labels.saving : labels.submitPassword}}
            </button>
          </view>
        </view>

        <view class="security-row">
          <text class="security-label">{{labels.protectionTitle}}</text>
          <text class="mp-muted">{{labels.protectionNote}}</text>
        </view>
      </view>

      <view class="mp-card">
        <view class="mp-card-title">{{labels.helpTitle}}</view>
        <view class="mp-muted security-note">{{labels.helpNote}}</view>
        <view class="security-actions">
          <button class="mp-btn mp-btn-primary" bindtap="goLogin">{{labels.relogin}}</button>
        </view>
      </view>
    </block>
  </block>
</view>
