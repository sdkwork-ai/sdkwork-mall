.security-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.security-row:last-child {
  border-bottom: none;
}

.security-label {
  font-size: 26rpx;
  color: #374151;
  flex-shrink: 0;
}

.security-value {
  font-size: 26rpx;
  color: #111827;
  text-align: right;
  margin-left: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.security-note {
  line-height: 1.7;
  padding-bottom: 16rpx;
}

.security-actions {
  display: flex;
  justify-content: center;
}
