.fav-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.fav-row:last-child {
  border-bottom: none;
}

.fav-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.fav-body {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}

.fav-title {
  font-size: 28rpx;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fav-remove {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.page-favorites-note {
  margin-top: 24rpx;
  text-align: center;
}
