<view class="page-buyer">
  <view class="buyer-hero">
    <view class="buyer-avatar">{{avatarText}}</view>
    <view class="buyer-hero-body">
      <block wx:if="{{loggedIn}}">
        <view class="buyer-name">{{displayName}}</view>
        <view class="buyer-sub">欢迎回来</view>
      </block>
      <block wx:else>
        <view class="buyer-name">未登录</view>
        <button class="mp-btn buyer-login-btn" bindtap="goLogin">点击登录</button>
      </block>
    </view>
    <view wx:if="{{loggedIn}}" class="buyer-logout" bindtap="logout">退出</view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">我的订单</view>
    <view class="buyer-order-entries">
      <view
        class="buyer-order-entry"
        wx:for="{{orderEntries}}"
        wx:key="status"
        bindtap="goOrderEntry"
        data-status="{{item.status}}"
      >
        <image class="buyer-order-entry-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
        <view class="buyer-order-entry-count">{{item.count}}</view>
        <view class="buyer-order-entry-label">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{statsUnavailable}}" class="mp-muted buyer-stats-note">订单数量暂不可用，点进订单列表查看</view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">我的资产</view>
    <view class="buyer-asset-list">
      <view
        class="buyer-asset-row"
        wx:for="{{assetLinks}}"
        wx:key="label"
        bindtap="goCapability"
        data-capability="{{item.capability}}"
      >
        <view class="buyer-asset-label">
          <image class="buyer-asset-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
          <text>{{item.label}}</text>
        </view>
        <view class="buyer-asset-chevron">›</view>
      </view>
    </view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">常用服务</view>
    <view class="buyer-quick-grid">
      <view
        class="buyer-quick-item"
        wx:for="{{quickLinks}}"
        wx:key="label"
        bindtap="goCapability"
        data-capability="{{item.capability}}"
      >
        <image class="buyer-quick-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
        <view class="buyer-quick-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">账户</view>
    <view class="buyer-asset-list">
      <view
        class="buyer-asset-row"
        wx:for="{{accountLinks}}"
        wx:key="label"
        bindtap="goCapability"
        data-capability="{{item.capability}}"
      >
        <view class="buyer-asset-label">{{item.label}}</view>
        <view class="buyer-asset-chevron">›</view>
      </view>
    </view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">其他</view>
    <view class="buyer-quick-grid">
      <view
        class="buyer-quick-item"
        wx:for="{{otherLinks}}"
        wx:key="label"
        bindtap="goCapability"
        data-capability="{{item.capability}}"
      >
        <image class="buyer-quick-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
        <view class="buyer-quick-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
