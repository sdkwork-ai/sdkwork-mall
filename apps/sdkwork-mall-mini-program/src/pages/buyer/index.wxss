.page-buyer {
  padding-bottom: 40rpx;
}

.buyer-hero {
  background: linear-gradient(135deg, #e93b3d, #f97316);
  color: #fff;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  position: relative;
}

.buyer-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.buyer-hero-body {
  margin-left: 26rpx;
}

.buyer-name {
  font-size: 34rpx;
  font-weight: 700;
}

.buyer-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* Solid white pill on the gradient: the ghost variant made white-on-white text. */
.buyer-login-btn {
  margin-top: 14rpx;
  margin-left: 0;
  background: #ffffff;
  color: #e93b3d;
  border: 1rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  padding: 12rpx 30rpx;
}

.buyer-logout {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.buyer-order-entries {
  display: flex;
  justify-content: space-between;
}

.buyer-order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.buyer-order-entry-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.buyer-order-entry-count {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  min-height: 40rpx;
}

.buyer-order-entry-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
  white-space: nowrap;
}

/*
 * Four equal columns with plain flex wrapping. `display: grid` is not reliable on
 * every base library and it collapsed the tiles to one character wide, which
 * rendered the labels vertically.
 */
.buyer-quick-grid {
  display: flex;
  flex-wrap: wrap;
}

.buyer-quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 4rpx;
  box-sizing: border-box;
}

.buyer-quick-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
}

.buyer-quick-label {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.3;
  white-space: nowrap;
}

.buyer-asset-list {
  display: flex;
  flex-direction: column;
}

.buyer-asset-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.buyer-asset-row:last-child {
  border-bottom: none;
}

.buyer-asset-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111827;
}

.buyer-asset-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.buyer-asset-chevron {
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}
