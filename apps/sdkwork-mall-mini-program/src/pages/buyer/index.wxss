.page-buyer {
  padding-bottom: 40rpx;
}

.buyer-hero {
  background: linear-gradient(135deg, #e93b3d, #f97316);
  color: #fff;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  position: relative;
}

.buyer-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.buyer-hero-body {
  margin-left: 26rpx;
}

.buyer-name {
  font-size: 34rpx;
  font-weight: 700;
}

.buyer-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.buyer-login-btn {
  margin-top: 12rpx;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  padding: 6rpx 26rpx;
}

.buyer-logout {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.buyer-order-entries {
  display: flex;
  justify-content: space-between;
}

.buyer-order-entry {
  text-align: center;
  flex: 1;
}

.buyer-order-entry-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  min-height: 44rpx;
}

.buyer-order-entry-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.buyer-quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.buyer-quick-item {
  width: calc(25% - 15rpx);
  text-align: center;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 26rpx 0;
  font-size: 24rpx;
  box-sizing: border-box;
}
