.address-pickable {
  border: 2rpx solid transparent;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
}

.address-default {
  color: #e93b3d;
  font-size: 22rpx;
  border: 1rpx solid #e93b3d;
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.address-line {
  margin-top: 10rpx;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.address-action {
  font-size: 24rpx;
  padding: 6rpx 26rpx;
}

.address-create {
  margin: 30rpx;
}

.address-create-btn {
  width: 100%;
  font-size: 30rpx;
}

.address-picker {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.address-editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.address-editor-actions button {
  flex: 1;
}
