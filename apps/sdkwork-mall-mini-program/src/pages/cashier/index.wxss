.cashier-method {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.cashier-method-active {
  border-color: #e93b3d;
  background: #fef2f2;
}

.cashier-actions {
  margin: 30rpx 0;
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cashier-pay {
  width: 100%;
  font-size: 30rpx;
}

.cashier-cancel {
  width: 100%;
}
