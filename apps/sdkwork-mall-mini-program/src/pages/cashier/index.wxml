<view class="page-cashier">
  <view wx:if="{{loading}}" class="mp-loading">加载收银台...</view>
  <view wx:elif="{{error}}" class="mp-error">{{error}}</view>

  <block wx:else>
    <view class="mp-card">
      <view class="mp-card-title">收银台</view>
      <view class="mp-muted">订单号：{{orderId}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">选择支付方式</view>
      <view
        class="cashier-method {{selectedCode === item.code ? 'cashier-method-active' : ''}}"
        wx:for="{{methods}}"
        wx:key="id"
        bindtap="selectMethod"
        data-code="{{item.code}}"
      >{{item.label}}</view>
      <view wx:if="{{methods.length === 0}}" class="mp-muted">暂无可用支付渠道，请稍后重试。</view>
    </view>

    <view class="cashier-actions">
      <button class="mp-btn mp-btn-primary cashier-pay" disabled="{{paying || !selectedCode}}" bindtap="pay">
        {{paying ? '支付中...' : '立即支付'}}
      </button>
      <button class="mp-btn mp-btn-ghost cashier-cancel" bindtap="cancel">稍后支付</button>
    </view>
  </block>
</view>
