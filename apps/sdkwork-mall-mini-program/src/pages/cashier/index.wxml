<view class="page-cashier">
  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:elif="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <block wx:else>
    <view class="mp-card">
      <view class="mp-card-title">{{titleText}}</view>
      <view class="mp-muted">{{orderNoText}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{methodsTitle}}</view>
      <view
        class="cashier-method {{selectedCode === item.code ? 'cashier-method-active' : ''}}"
        wx:for="{{methods}}"
        wx:key="id"
        bindtap="selectMethod"
        data-code="{{item.code}}"
      >{{item.label}}</view>
      <view wx:if="{{methods.length === 0}}" class="mp-muted">{{methodsEmpty}}</view>
    </view>

    <view class="cashier-actions">
      <button class="mp-btn mp-btn-primary cashier-pay" disabled="{{paying || !selectedCode}}" bindtap="pay">
        {{paying ? payingText : payText}}
      </button>
      <button class="mp-btn mp-btn-ghost cashier-cancel" bindtap="cancel">{{laterText}}</button>
    </view>
  </block>
</view>
