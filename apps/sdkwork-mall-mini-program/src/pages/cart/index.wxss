.page-cart {
  padding-bottom: 140rpx;
}

.cart-login-btn {
  margin-top: 30rpx;
  width: 260rpx;
}

.cart-select-all {
  margin: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.cart-checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.cart-checkbox-on {
  background: #e93b3d;
  border-color: #e93b3d;
  position: relative;
}

.cart-checkbox-on::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 5rpx;
  width: 8rpx;
  height: 16rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(40deg);
}

.cart-shop {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 0 20rpx 0;
  overflow: hidden;
}

.cart-shop-header {
  font-weight: 600;
  border-bottom: 1rpx solid #f3f4f6;
}

.cart-shop-name {
  font-size: 28rpx;
}

.cart-item {
  border-bottom: 1rpx solid #f9fafb;
}

.cart-item-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  flex-shrink: 0;
}

.cart-item-image image {
  width: 100%;
  height: 100%;
}

.cart-item-body {
  flex: 1;
  margin: 0 16rpx;
}

.cart-quantity {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
}

.cart-quantity-btn {
  padding: 4rpx 18rpx;
  font-size: 28rpx;
  color: #374151;
}

.cart-quantity-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 26rpx;
}

.cart-remove {
  color: #9ca3af;
  font-size: 24rpx;
  padding: 6rpx;
  align-self: flex-start;
}

.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f3f4f6;
  z-index: 10;
}

.cart-total {
  font-size: 28rpx;
}

.cart-checkout-btn {
  min-width: 240rpx;
}
