<view class="page-help">
  <view class="mp-card">
    <view class="mp-card-title">{{title}}</view>
    <view class="mp-muted">{{subtitle}}</view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">{{quickTitle}}</view>
    <view class="help-quick-grid">
      <view
        class="help-quick-item"
        wx:for="{{quickLinks}}"
        wx:key="capability"
        bindtap="goQuickLink"
        data-capability="{{item.capability}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="mp-card" wx:for="{{sections}}" wx:key="title">
    <view class="mp-card-title">{{item.title}}</view>
    <view class="help-line" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">{{line}}</view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">{{contactTitle}}</view>
    <view class="mp-row help-contact" bindtap="goChats">
      <text class="help-contact-label">{{contactOnline}}</text>
      <text class="mp-muted">{{contactHours}} ></text>
    </view>
  </view>
</view>
