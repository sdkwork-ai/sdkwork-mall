.page-logistics {
  padding: 20rpx 24rpx 40rpx;
}

.logistics-back {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.logistics-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.logistics-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.logistics-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.logistics-timeline {
  margin-top: 24rpx;
  padding-left: 8rpx;
}

.logistics-event {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 0 0 32rpx 36rpx;
}

.logistics-event::before {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #e5e7eb;
}

.logistics-event:last-child {
  padding-bottom: 4rpx;
}

.logistics-event:last-child::before {
  display: none;
}

.logistics-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d1d5db;
}

.logistics-event-latest .logistics-dot {
  background: #e93b3d;
  box-shadow: 0 0 0 6rpx rgba(233, 59, 61, 0.12);
}

.logistics-event-body {
  flex: 1;
  min-width: 0;
}

.logistics-event-text {
  font-size: 27rpx;
  color: #374151;
  line-height: 1.5;
}

.logistics-event-latest .logistics-event-text {
  color: #111827;
  font-weight: 600;
}

.logistics-event-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
}
