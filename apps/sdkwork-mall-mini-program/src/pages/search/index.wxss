.search-bar {
  display: flex;
  align-items: center;
  background: #e93b3d;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
}

.search-btn {
  padding: 8rpx 30rpx;
}

.search-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.search-chip {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #374151;
}

.search-chip-active {
  color: #e93b3d;
  border-color: #e93b3d;
  background: #fef2f2;
}

.search-sorts {
  display: flex;
  gap: 30rpx;
  padding: 10rpx 30rpx 20rpx;
}

.search-sort {
  font-size: 26rpx;
  color: #6b7280;
}

.search-sort-active {
  color: #e93b3d;
  font-weight: 600;
}
