.fp-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.fp-row:last-child {
  border-bottom: none;
}

.fp-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.fp-body {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.fp-title {
  font-size: 28rpx;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.footprint-clear {
  color: #e93b3d;
  text-align: right;
}
