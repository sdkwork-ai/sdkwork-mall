<view class="page-payment-result">
  <view class="result-hero result-hero-{{tone}}">
    <view class="result-title">{{title}}</view>
    <view class="result-desc">{{description}}</view>
    <view class="result-meta" wx:if="{{orderNoText}}">{{orderNoText}}</view>
    <view class="result-meta" wx:if="{{paymentNoText}}">{{paymentNoText}}</view>
    <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  </view>

  <view class="result-actions">
    <button class="mp-btn mp-btn-primary" bindtap="goOrders">{{ordersText}}</button>
    <button wx:if="{{pollExhausted && status !== 'success'}}" class="mp-btn mp-btn-ghost" bindtap="restartPoll">{{refreshText}}</button>
    <button wx:if="{{status === 'failed'}}" class="mp-btn mp-btn-ghost" bindtap="retryPay">{{retryPayText}}</button>
    <button class="mp-btn mp-btn-ghost" bindtap="goHome">{{continueShoppingText}}</button>
  </view>
</view>
