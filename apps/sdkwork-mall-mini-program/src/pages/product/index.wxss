.page-product {
  padding-bottom: 140rpx;
}

.product-gallery {
  height: 640rpx;
  background: #fff;
}

.product-gallery-image {
  width: 100%;
  height: 100%;
  background: #f3f4f6;
}

.product-gallery-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 32rpx;
}

.product-summary {
  margin-top: 20rpx;
}

.product-price {
  font-size: 44rpx;
}

.product-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 12rpx;
  line-height: 1.5;
}

.product-sales {
  margin-top: 10rpx;
}

.product-soldout {
  color: #e93b3d;
}

.product-spec {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.product-spec-name {
  color: #6b7280;
  width: 200rpx;
  flex-shrink: 0;
}

.product-spec-value {
  color: #1f2937;
}

.product-description {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.product-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  gap: 12rpx;
  border-top: 1rpx solid #f3f4f6;
  z-index: 10;
}

.product-shop-entry {
  color: #e93b3d;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.product-action-fav {
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 2.4;
  padding: 0 18rpx;
  background: #fff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
}

.product-action-fav-active {
  color: #e93b3d;
  border-color: #fca5a5;
  background: #fef2f2;
}

.product-action-cart,
.product-action-buy {
  flex: 1;
  min-width: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 2.4;
  padding: 0 16rpx;
}

.product-action-cart {
  background: #fff7ed;
  color: #ea580c;
  border: 1rpx solid #fdba74;
}

.product-action-buy {
  background: #e93b3d;
  color: #fff;
}

.product-action-cart[disabled],
.product-action-buy[disabled] {
  opacity: 0.5;
}

.product-sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.5);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.product-sku-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.product-sku-head {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

/* ── H5-parity surfaces: service strip, coupon row, reviews, recommendations ── */

.product-service {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.product-service-item {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.product-offer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.product-offer:last-child {
  border-bottom: 0;
}

.product-offer-body {
  flex: 1;
  min-width: 0;
}

.product-offer-title {
  font-size: 26rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-offer-claim {
  flex-shrink: 0;
  margin-left: 20rpx;
  min-height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.product-reviews {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}

.product-reviews-stars {
  color: #f59e0b;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.product-recs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.product-rec {
  width: 200rpx;
  flex-shrink: 0;
}

.product-rec-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 24rpx;
}

.product-rec-image image {
  width: 100%;
  height: 100%;
}

.product-rec-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1f2937;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-rec-price {
  margin-top: 4rpx;
  font-size: 26rpx;
}

.product-urgent {
  color: #ea580c;
}

.product-action-icon {
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 2.6;
  padding: 0 14rpx;
  background: #fff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
}

.product-sku-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 22rpx;
  flex-shrink: 0;
}

.product-sku-thumb image {
  width: 100%;
  height: 100%;
}

.product-sku-meta {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.product-sku-stock {
  font-size: 22rpx;
}

.product-sku-close {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 8rpx 12rpx;
}

.product-sku-selected {
  margin-bottom: 20rpx;
}

.product-sku-quantity {
  padding: 16rpx 0 24rpx;
  font-size: 26rpx;
}

.product-sku-confirm {
  width: 100%;
  min-height: 88rpx;
}
