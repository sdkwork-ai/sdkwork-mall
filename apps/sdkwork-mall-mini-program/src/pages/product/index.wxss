.page-product {
  padding-bottom: 140rpx;
}

.product-gallery {
  height: 640rpx;
  background: #fff;
}

.product-gallery-image {
  width: 100%;
  height: 100%;
  background: #f3f4f6;
}

.product-gallery-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  font-size: 32rpx;
}

.product-summary {
  margin-top: 20rpx;
}

.product-price {
  font-size: 44rpx;
}

.product-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 12rpx;
  line-height: 1.5;
}

.product-sales {
  margin-top: 10rpx;
}

.product-soldout {
  color: #e93b3d;
}

.product-spec {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.product-spec-name {
  color: #6b7280;
  width: 200rpx;
  flex-shrink: 0;
}

.product-spec-value {
  color: #1f2937;
}

.product-description {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.product-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  gap: 20rpx;
  border-top: 1rpx solid #f3f4f6;
  z-index: 10;
}

.product-action-cart,
.product-action-buy {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.product-action-cart {
  background: #fff7ed;
  color: #ea580c;
  border: 1rpx solid #fdba74;
}

.product-action-buy {
  background: #e93b3d;
  color: #fff;
}

.product-action-cart[disabled],
.product-action-buy[disabled] {
  opacity: 0.5;
}

.product-sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.5);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.product-sku-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.product-sku-head {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}
