<view class="page-product">
  <view wx:if="{{loading}}" class="mp-loading">加载商品...</view>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>
  <view wx:if="{{notFound}}" class="mp-empty">
    <view>商品不存在或已下架</view>
    <button class="mp-btn mp-btn-ghost" bindtap="goHome">回到首页</button>
  </view>

  <block wx:if="{{detail}}">
    <swiper class="product-gallery" indicator-dots circular bindchange="onImageChange" current="{{activeImage}}">
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image
          class="product-gallery-image"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="previewImage"
        />
      </swiper-item>
      <swiper-item wx:if="{{images.length === 0}}">
        <view class="product-gallery-image product-gallery-fallback">暂无主图</view>
      </swiper-item>
    </swiper>

    <view class="mp-card product-summary">
      <view class="mp-price product-price">{{displayPrice || priceFallback}}</view>
      <view class="product-title">{{detail.title}}</view>
      <view class="mp-muted product-brand" wx:if="{{detail.brand}}">品牌：{{detail.brand}}</view>
      <view class="mp-muted product-sales">
        <text wx:if="{{detail.sales}}">已售 {{detail.sales}}</text>
        <text wx:if="{{maxQuantity != null}}"> · 库存 {{maxQuantity}}</text>
        <text wx:if="{{stockUrgent}}" class="product-urgent"> · 仅剩 {{maxQuantity}} 件</text>
        <text wx:if="{{soldOut}}" class="product-soldout"> · 暂时售罄</text>
      </view>

      <view class="product-service">
        <text class="product-service-item">正品保障</text>
        <text class="product-service-item">七天无理由</text>
        <text class="product-service-item">极速退款</text>
      </view>

      <view class="product-delivery" bindtap="goAddress">
        <text class="mp-muted">{{deliveryLabel}}</text>
        <text class="product-delivery-value">{{deliveryText}}</text>
        <text class="product-delivery-chevron">›</text>
      </view>
    </view>

    <view class="mp-card" wx:if="{{offers.length}}">
      <view class="mp-card-title">优惠券</view>
      <view class="product-offer" wx:for="{{offers}}" wx:key="id">
        <view class="product-offer-body">
          <view class="product-offer-title">{{item.title}}</view>
          <view class="mp-muted" wx:if="{{item.discountText}}">{{item.discountText}}</view>
        </view>
        <button
          class="mp-btn mp-btn-plain product-offer-claim"
          disabled="{{claimingOfferId === item.id}}"
          catchtap="claimOffer"
          data-id="{{item.id}}"
        >领取</button>
      </view>
    </view>

    <view class="mp-card" wx:if="{{skus.length}}">
      <view class="mp-card-title">选择规格</view>
      <view class="search-chips">
        <text
          class="search-chip {{selectedSkuId === item.id ? 'search-chip-active' : ''}}"
          wx:for="{{skus}}"
          wx:key="id"
          bindtap="selectSku"
          data-id="{{item.id}}"
        >{{item.title}}</text>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-flex-between">
        <view class="mp-card-title">购买数量</view>
        <view class="cart-quantity">
          <text class="cart-quantity-btn" bindtap="decreaseQuantity">−</text>
          <text class="cart-quantity-num">{{quantity}}</text>
          <text class="cart-quantity-btn" bindtap="increaseQuantity">+</text>
        </view>
      </view>
    </view>

    <view class="mp-card" wx:if="{{specs.length}}">
      <view class="mp-card-title">规格参数</view>
      <view class="product-spec" wx:for="{{specs}}" wx:key="name">
        <text class="product-spec-name">{{item.name}}</text>
        <text class="product-spec-value">{{item.value}}</text>
      </view>
    </view>

    <view class="mp-card" wx:if="{{detail.shopId}}">
      <view class="mp-flex-between" bindtap="goShop" data-id="{{detail.shopId}}">
        <view>
          <view class="mp-card-title">店铺</view>
          <view class="mp-muted">{{detail.shopName || detail.shopId}}</view>
        </view>
        <view class="product-shop-entry">进店 ›</view>
      </view>
    </view>

    <view class="mp-card" wx:if="{{detail.description}}">
      <view class="mp-card-title">商品介绍</view>
      <view class="product-description">{{detail.description}}</view>
    </view>

    <view class="mp-card" wx:if="{{recommendations.length}}">
      <view class="mp-card-title">看了又看</view>
      <view class="product-recs">
        <view
          class="product-rec"
          wx:for="{{recommendations}}"
          wx:key="id"
          bindtap="goRecommendation"
          data-id="{{item.id}}"
        >
          <view class="product-rec-image">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
            <text wx:else>SDKWork</text>
          </view>
          <view class="product-rec-title">{{item.title}}</view>
          <view class="mp-price product-rec-price">{{item.priceText}}</view>
        </view>
      </view>
    </view>

    <view class="product-actions">
      <button class="product-action-icon" bindtap="goHome">首页</button>
      <button class="product-action-icon" bindtap="goChat">客服</button>
      <button
        class="product-action-fav {{favorite ? 'product-action-fav-active' : ''}}"
        bindtap="toggleFavorite"
      >{{favorite ? favoritedText : favoriteText}}</button>
      <button class="product-action-cart" disabled="{{busy || soldOut || !purchasable}}" bindtap="openSkuPopup" data-mode="cart">{{purchasable ? addToCartText : unavailableText}}</button>
      <button class="product-action-buy" disabled="{{busy || soldOut || !purchasable}}" bindtap="openSkuPopup" data-mode="buy">{{soldOut ? soldOutText : (purchasable ? buyNowText : unavailableText)}}</button>
    </view>

    <view wx:if="{{skuPopupOpen}}" class="product-sku-mask" bindtap="closeSkuPopup">
      <view class="product-sku-popup" catchtap="noop">
        <view class="mp-flex-between product-sku-head">
          <view class="mp-flex">
            <view class="product-sku-thumb">
              <image wx:if="{{images[0]}}" src="{{images[0]}}" mode="aspectFill" lazy-load />
              <text wx:else>SDKWork</text>
            </view>
            <view class="product-sku-meta">
              <text class="mp-price">{{displayPrice}}</text>
              <text class="mp-muted product-sku-stock" wx:if="{{maxQuantity != null}}">库存 {{maxQuantity}}</text>
            </view>
          </view>
          <text class="product-sku-close" bindtap="closeSkuPopup">关闭</text>
        </view>

        <view class="mp-muted product-sku-selected">已选：{{selectedSkuTitle || defaultSkuText}}</view>

        <view class="mp-flex-between product-sku-quantity">
          <text>数量</text>
          <view class="cart-quantity">
            <text class="cart-quantity-btn" bindtap="decreaseQuantity">−</text>
            <text class="cart-quantity-num">{{quantity}}</text>
            <text class="cart-quantity-btn" bindtap="increaseQuantity">+</text>
          </view>
        </view>

        <button class="mp-btn mp-btn-primary product-sku-confirm" disabled="{{busy || soldOut}}" bindtap="confirmSkuPopup">
          {{skuPopupMode === 'buy' ? buyNowText : addToCartText}}
        </button>
      </view>
    </view>
  </block>

  <view wx:if="{{toast}}" class="mp-toast">{{toast}}</view>
</view>
