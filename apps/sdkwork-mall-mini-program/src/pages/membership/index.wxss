.membership-hero {
  background: linear-gradient(135deg, #2b2b33, #4b3f4e);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.membership-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.membership-level {
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.membership-status {
  margin-top: 8rpx;
  color: #e5e7eb;
}

.plan-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 28rpx;
  font-weight: 600;
}

.plan-row:last-child {
  border-bottom: none;
}
