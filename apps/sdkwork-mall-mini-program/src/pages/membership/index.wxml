<view class="page-membership">
  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:if="{{message}}" class="mp-error">
    <text>{{message}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <block wx:if="{{!loading}}">
    <view class="membership-hero">
      <view class="membership-label">{{levelLabel}}</view>
      <view class="membership-level">{{status ? status.levelName : defaultLevel}}</view>
      <view class="mp-muted membership-status" wx:if="{{status}}">{{status.status}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{plansTitle}}</view>
      <view wx:if="{{packages.length === 0}}" class="mp-empty">{{plansEmpty}}</view>
      <view class="plan-row" wx:for="{{packages}}" wx:key="id">
        <view class="mp-flex-between">
          <view>
            <view class="plan-name">
              {{item.name}}
              <text wx:if="{{item.recommended}}" class="plan-recommended">★</text>
            </view>
            <view class="mp-muted" wx:if="{{item.durationText}}">{{item.durationText}}</view>
            <view class="mp-muted" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="mp-price">{{item.priceText}}</view>
          </view>
          <button
            class="mp-btn mp-btn-primary"
            disabled="{{busyPackageId !== null}}"
            bindtap="purchase"
            data-id="{{item.id}}"
          >{{busyPackageId === item.id ? openingText : (isMember ? renewText : openText)}}</button>
        </view>
      </view>
    </view>
  </block>
</view>
