.page-partner {
  padding: 24rpx 24rpx 64rpx;
}

.partner-eyebrow {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.partner-status-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 4rpx 0 12rpx;
}

.partner-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0;
}

.partner-chip {
  background: #fdecec;
  border-radius: 999rpx;
  color: #c0272d;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
}

.partner-error {
  color: #c0272d;
  margin: 16rpx 0 24rpx;
}

.partner-empty {
  margin: 16rpx 0;
}

.partner-invite-result {
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
}

.partner-invite-valid {
  background: #eaf7ed;
  border: 2rpx solid #b7e0c0;
}

.partner-invite-invalid {
  background: #fdecec;
  border: 2rpx solid #f0bfc2;
}

.partner-invite-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.partner-picker {
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.partner-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.partner-issues {
  margin-top: 16rpx;
}

.partner-issue {
  color: #c0272d;
  font-size: 24rpx;
}

.partner-level,
.partner-application {
  border-bottom: 2rpx solid #f0f1f3;
  padding: 24rpx 0;
}

.partner-level:last-child,
.partner-application:last-child {
  border-bottom: 0;
}

.partner-level-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.partner-level-name {
  font-size: 30rpx;
  font-weight: 600;
}

.partner-level-meta {
  color: #4b5563;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.partner-benefits {
  margin-top: 12rpx;
}

.partner-benefit {
  color: #4b5563;
  font-size: 26rpx;
  padding-left: 20rpx;
  position: relative;
}

.partner-benefit::before {
  content: "·";
  left: 0;
  position: absolute;
}

.partner-rules {
  border-top: 2rpx solid #f0f1f3;
  margin-top: 20rpx;
  padding-top: 20rpx;
}

/* Join application modal: a dedicated overlay, never an in-flow card. */
.partner-modal {
  inset: 0;
  position: fixed;
  z-index: 1000;
}

.partner-modal-mask {
  background: rgba(17, 24, 39, 0.55);
  inset: 0;
  position: absolute;
}

.partner-modal-panel {
  background: #ffffff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  left: 32rpx;
  max-height: 88vh;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.partner-modal-head {
  align-items: center;
  border-bottom: 2rpx solid #eceef1;
  display: flex;
  justify-content: space-between;
  padding: 32rpx 40rpx;
}

.partner-modal-title {
  font-size: 36rpx;
  font-weight: 600;
}

.partner-modal-close {
  background: transparent;
  border: 0;
  color: #6b7280;
  font-size: 48rpx;
  line-height: 1;
  padding: 0 16rpx;
}

.partner-modal-body {
  flex: 1;
  min-height: 0;
}

.partner-modal-card {
  border: 0;
  box-shadow: none;
  margin: 0;
}

.partner-invite-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.partner-invite-btn {
  min-height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}
