<view class="page-partner">
  <view class="mp-muted partner-eyebrow">{{labels.pageEyebrow}}</view>
  <view class="mp-title">{{labels.pageTitle}}</view>

  <view wx:if="{{loading}}" class="mp-card">
    <view class="mp-muted">{{labels.loading}}</view>
  </view>

  <view wx:elif="{{error}}" class="mp-card mp-error">
    <view class="mp-card-title">{{labels.pageTitle}}</view>
    <view class="mp-muted partner-error">{{error}}</view>
    <button class="mp-btn mp-btn-primary" bindtap="retry">{{labels.retry}}</button>
  </view>

  <block wx:else>
    <view class="mp-card">
      <view class="partner-status-title">{{statusTitle}}</view>
      <view class="mp-muted">{{statusDescription}}</view>
      <view class="partner-chips">
        <view class="partner-chip" wx:for="{{summary}}" wx:key="*this">{{item}}</view>
      </view>
      <button
        wx:if="{{membershipState !== 'pending'}}"
        class="mp-btn mp-btn-primary"
        bindtap="openForm"
      >{{membershipState === 'approved' ? labels.actionsReapply : labels.actionsApply}}</button>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{labels.centerTitle}}</view>
      <block wx:if="{{center}}">
        <view class="partner-level-meta">
          {{labels.teamTitle}} {{center.teamSize}} · {{labels.directTeam}} {{center.directTeamSize}} ·
          {{labels.customers}} {{center.customerCount}}
        </view>
        <view class="mp-muted">{{labels.inviteCodeLabel}}: {{center.inviteCode || '—'}}</view>
      </block>
      <view wx:else class="mp-muted">{{centerNotice}}</view>
    </view>

    <view wx:if="{{center}}" class="mp-card">
      <view class="mp-card-title">{{labels.teamTitle}}</view>
      <view wx:if="{{!team.length}}" class="mp-muted partner-empty">{{labels.teamEmpty}}</view>
      <view class="partner-level" wx:for="{{team}}" wx:key="partnerId">
        <view class="partner-level-head">
          <text class="partner-level-name">{{item.name}}</text>
          <text class="mp-muted">{{item.levelText}}</text>
        </view>
        <view class="mp-muted">{{item.metaText}}</view>
        <view class="partner-level-meta">{{item.commissionText}} · {{item.balanceText}}</view>
        <view class="mp-muted">{{item.joinedText}}</view>
      </view>
      <view class="partner-actions" wx:if="{{teamTotal}}">
        <button class="mp-btn mp-btn-ghost" data-page="{{teamPage - 1}}" disabled="{{teamPage <= 1 || teamLoading}}" bindtap="teamPage">{{labels.teamPrev}}</button>
        <text class="mp-muted">{{teamPageText}}</text>
        <button class="mp-btn mp-btn-ghost" data-page="{{teamPage + 1}}" disabled="{{teamPage * 10 >= teamTotal || teamLoading}}" bindtap="teamPage">{{labels.teamNext}}</button>
      </view>
    </view>

    <view wx:if="{{center}}" class="mp-card">
      <view class="mp-card-title">{{labels.commissionsTitle}}</view>
      <view wx:if="{{!commissions.length}}" class="mp-muted partner-empty">{{labels.commissionsEmpty}}</view>
      <view class="partner-level" wx:for="{{commissions}}" wx:key="id">
        <view class="partner-level-head">
          <text class="partner-level-name">{{item.amountText}}</text>
          <text class="mp-muted">{{item.statusText}}</text>
        </view>
        <view class="mp-muted">{{item.sourceText}}</view>
        <view class="partner-level-meta">{{item.baseText}} · {{item.ratioText}}</view>
        <view class="mp-muted">{{item.metaText}}</view>
      </view>
      <view class="partner-actions" wx:if="{{commissionTotal}}">
        <button class="mp-btn mp-btn-ghost" data-page="{{commissionPage - 1}}" disabled="{{commissionPage <= 1 || commissionLoading}}" bindtap="commissionPageTap">{{labels.commissionsPrev}}</button>
        <text class="mp-muted">{{commissionPageText}}</text>
        <button class="mp-btn mp-btn-ghost" data-page="{{commissionPage + 1}}" disabled="{{commissionPage * 10 >= commissionTotal || commissionLoading}}" bindtap="commissionPageTap">{{labels.commissionsNext}}</button>
      </view>
    </view>

    <view wx:if="{{center}}" class="mp-card">
      <view class="mp-card-title">{{labels.withdrawTitle}}</view>
      <view class="partner-level-meta">
        {{labels.withdrawAvailable}} {{center.availableBalance}} · {{labels.withdrawPending}} {{center.frozenBalance}} ·
        {{labels.withdrawTotal}} {{center.totalCommission}} · {{labels.withdrawWithdrawn}} {{center.withdrawnAmount}}
      </view>
      <view class="mp-muted">{{labels.withdrawMin}} {{center.minWithdrawalAmount}}</view>
      <view class="mp-field">
        <view class="mp-field-label">{{labels.withdrawAmount}}</view>
        <input type="digit" placeholder="{{labels.withdrawAmountPlaceholder}}" value="{{withdrawAmount}}" bindinput="onWithdrawAmountInput" />
      </view>
      <view class="mp-field">
        <view class="mp-field-label">{{labels.withdrawRemark}}</view>
        <input placeholder="{{labels.withdrawRemarkPlaceholder}}" value="{{withdrawRemark}}" bindinput="onWithdrawRemarkInput" />
      </view>
      <view wx:if="{{withdrawError}}" class="partner-issue">{{withdrawError}}</view>
      <view wx:if="{{withdrawSuccess}}" class="mp-muted">{{labels.withdrawSuccess}}</view>
      <button class="mp-btn mp-btn-primary" disabled="{{withdrawing}}" bindtap="submitWithdrawal">{{labels.withdrawSubmit}}</button>
      <view wx:if="{{!withdrawals.length}}" class="mp-muted partner-empty">{{labels.withdrawEmpty}}</view>
      <view class="partner-level" wx:for="{{withdrawals}}" wx:key="id">
        <view class="partner-level-head">
          <text class="partner-level-name">{{item.amountText}}</text>
          <text class="mp-muted">{{item.statusText}}</text>
        </view>
        <view class="mp-muted">{{item.metaText}}</view>
        <view wx:if="{{item.reviewComment}}" class="mp-muted">{{labels.reviewComment}}：{{item.reviewComment}}</view>
      </view>
      <view class="partner-actions" wx:if="{{withdrawalTotal}}">
        <button class="mp-btn mp-btn-ghost" data-page="{{withdrawalPage - 1}}" disabled="{{withdrawalPage <= 1 || withdrawalLoading}}" bindtap="withdrawalPageTap">{{labels.withdrawPrev}}</button>
        <text class="mp-muted">{{withdrawalPageText}}</text>
        <button class="mp-btn mp-btn-ghost" data-page="{{withdrawalPage + 1}}" disabled="{{withdrawalPage * 10 >= withdrawalTotal || withdrawalLoading}}" bindtap="withdrawalPageTap">{{labels.withdrawNext}}</button>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{labels.inviteTitle}}</view>
      <view class="mp-muted">{{labels.inviteDescription}}</view>
      <view class="mp-field">
        <input
          placeholder="{{labels.invitePlaceholder}}"
          value="{{inviteInput}}"
          bindinput="onInviteInput"
        />
      </view>
      <button
        class="mp-btn mp-btn-plain"
        disabled="{{!inviteInput || validating}}"
        bindtap="validateInvite"
      >{{labels.actionsValidate}}</button>
      <view wx:if="{{inviteResultTitle}}" class="partner-invite-result {{inviteValid ? 'partner-invite-valid' : 'partner-invite-invalid'}}">
        <view class="partner-invite-title">{{inviteResultTitle}}</view>
        <view wx:if="{{inviteResultDetail}}" class="mp-muted">{{inviteResultDetail}}</view>
      </view>
    </view>

    <view wx:if="{{formOpen}}" class="partner-modal">
      <view class="partner-modal-mask" catchtouchmove="noop" bindtap="closeForm"></view>
      <view class="partner-modal-panel" catchtap="noop">
        <view class="partner-modal-head">
          <text class="partner-modal-title">{{labels.applyTitle}}</text>
          <button class="partner-modal-close" bindtap="closeForm">×</button>
        </view>
        <scroll-view class="partner-modal-body" scroll-y>
          <view class="mp-card partner-modal-card">
      <view class="mp-muted">{{labels.applyDescription}}</view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applicantType}}</view>
        <picker
          mode="selector"
          range="{{applicantTypeOptions}}"
          value="{{form.applicantType === 'ORGANIZATION' ? 1 : 0}}"
          bindchange="onApplicantTypeChange"
        >
          <view class="partner-picker">
            {{form.applicantType === 'ORGANIZATION' ? labels.applyOrganization : labels.applyIndividual}}
          </view>
        </picker>
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applySubjectName}}</view>
        <input value="{{form.subjectName}}" data-field="subjectName" bindinput="onFieldInput" />
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyContactName}}</view>
        <input value="{{form.contactName}}" data-field="contactName" bindinput="onFieldInput" />
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyContactPhone}}</view>
        <input type="text" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="onFieldInput" />
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyContactEmail}}</view>
        <input type="text" value="{{form.contactEmail}}" data-field="contactEmail" bindinput="onFieldInput" />
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyTargetLevel}}</view>
        <picker
          mode="selector"
          range="{{levelOptions}}"
          range-key="label"
          bindchange="onTargetLevelChange"
        >
          <view class="partner-picker">
            <block wx:for="{{levelOptions}}" wx:key="value">
              <block wx:if="{{item.value === form.targetLevelNo}}">{{item.label}}</block>
            </block>
          </view>
        </picker>
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyInviteCode}}</view>
        <input value="{{form.inviteCode}}" data-field="inviteCode" bindinput="onFieldInput" />
      </view>

      <view class="mp-field">
        <view class="mp-field-label">{{labels.applyBusinessIntro}}</view>
        <textarea value="{{form.businessIntro}}" data-field="businessIntro" bindinput="onFieldInput" />
      </view>

      <view wx:if="{{issues.length}}" class="partner-issues">
        <view wx:for="{{issues}}" wx:key="*this" class="partner-issue">{{item}}</view>
      </view>

      <view class="partner-actions">
        <button class="mp-btn mp-btn-ghost" bindtap="closeForm">{{labels.actionsClose}}</button>
        <button class="mp-btn mp-btn-primary" disabled="{{submitting}}" bindtap="submit">
          {{submitting ? labels.actionsSubmitting : labels.applySubmit}}
        </button>
      </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{labels.programTitle}}</view>
      <view class="mp-muted">{{labels.programDescription}}</view>
      <view wx:if="{{!levels.length}}" class="mp-muted partner-empty">{{levelsEmptyText}}</view>
      <view class="partner-level" wx:for="{{levels}}" wx:key="levelNo">
        <view class="partner-level-head">
          <text class="partner-level-name">{{item.name}}</text>
          <text class="mp-muted">{{labels.programJoinFee}} {{item.joinFeeText}}</text>
        </view>
        <view class="partner-level-meta">
          {{labels.programCustomerRevenue}} {{item.customerRevenueText}} ·
          {{labels.programJoinFeeCommission}} {{item.joinFeeCommissionText}}
        </view>
        <view wx:if="{{item.benefits.length}}" class="partner-benefits">
          <view class="mp-muted">{{labels.programBenefits}}</view>
          <view wx:for="{{item.benefits}}" wx:key="*this" class="partner-benefit">{{item}}</view>
        </view>
      </view>
      <view class="mp-muted partner-rules">{{rulesText}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{labels.applicationsTitle}}</view>
      <view wx:if="{{!applications.length}}" class="mp-muted partner-empty">{{labels.applicationsEmpty}}</view>
      <view class="partner-application" wx:for="{{applications}}" wx:key="id">
        <view class="partner-level-head">
          <text class="partner-level-name">{{item.title}}</text>
          <text class="mp-muted">{{item.statusText}}</text>
        </view>
        <view class="mp-muted">{{item.metaText}}</view>
        <view wx:if="{{item.reviewComment}}" class="mp-muted">{{labels.reviewComment}}：{{item.reviewComment}}</view>
        <button
          wx:if="{{item.canCancel}}"
          class="mp-btn mp-btn-ghost"
          disabled="{{cancellingId === item.id}}"
          data-id="{{item.id}}"
          bindtap="cancelApplication"
        >{{labels.actionsCancel}}</button>
      </view>
    </view>
  </block>
</view>
