<view class="page-login">
  <view class="mp-card">
    <view class="mp-card-title">{{titleText}}</view>
    <view class="mp-muted login-hint">{{hintText}}</view>

    <button
      class="mp-btn mp-btn-primary login-btn"
      disabled="{{busy || !wechatAvailable}}"
      bindtap="loginWithWechat"
    >{{busy ? wechatLoginBusyText : wechatLoginText}}</button>

    <view class="login-fallback-switch" bindtap="toggleCredentialForm">
      {{showCredentialForm ? credentialCollapseText : credentialToggleText}}
    </view>

    <block wx:if="{{showCredentialForm}}">
      <view class="mp-field">
        <text class="mp-field-label">{{accountLabel}}</text>
        <input value="{{account}}" placeholder="{{accountPlaceholder}}" bindinput="onAccountInput" />
      </view>
      <view class="mp-field">
        <text class="mp-field-label">{{passwordLabel}}</text>
        <input password value="{{password}}" placeholder="{{passwordPlaceholder}}" bindinput="onPasswordInput" />
      </view>
      <button class="mp-btn mp-btn-primary login-btn" disabled="{{busy}}" bindtap="login">
        {{busy ? submittingText : submitText}}
      </button>
    </block>

    <view wx:if="{{error}}" class="mp-error">
      <text>{{error}}</text>
    </view>

    <block wx:if="{{devFallbackVisible}}">
      <view class="login-fallback-switch" bindtap="toggleFallback">{{devToggleText}}</view>
      <block wx:if="{{useTokenFallback}}">
        <view class="mp-muted login-hint">{{devHintText}}</view>
        <view class="mp-field">
          <text class="mp-field-label">{{tokenLabel}}</text>
          <input password value="{{token}}" placeholder="{{tokenPlaceholder}}" bindinput="onTokenInput" />
        </view>
        <button class="mp-btn mp-btn-ghost login-btn" bindtap="loginWithToken">{{submitText}}</button>
      </block>
    </block>

    <button wx:if="{{token}}" class="mp-btn mp-btn-ghost login-btn" bindtap="logout">{{logoutText}}</button>
  </view>
</view>
