.page-login {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

/* Brand poster: red → orange, square corners to match the flat storefront. */
.login-hero {
  background: linear-gradient(135deg, #e93b3d 0%, #f97316 100%);
  color: #ffffff;
  padding: 72rpx 40rpx 64rpx;
}

.login-logo {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.login-slogan {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  opacity: 0.95;
}

.login-hero-badge {
  display: inline-block;
  margin-top: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.login-panel {
  padding: 48rpx 40rpx 24rpx;
  background: #ffffff;
}

.login-heading {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.login-sub {
  margin-top: 12rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
}

/* Primary action: WeChat identity, the standard mini-program sign-in path. */
.login-wechat {
  width: 100%;
  min-height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #07c160;
  border: 0;
  border-radius: 999rpx;
  padding: 0 32rpx;
}

.login-wechat[disabled] {
  background: #a7e8c2;
  color: #ffffff;
}

.login-wechat::after {
  border: 0;
}

.login-note {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.login-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 28rpx;
}

.login-divider-line {
  flex: 1;
  height: 1rpx;
  background: #eef0f3;
}

.login-divider-text {
  font-size: 24rpx;
  color: #b0b6bf;
}

.login-field {
  margin-bottom: 28rpx;
}

.login-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.login-input-row {
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e7eb;
  background: #fafbfc;
}

.login-input {
  flex: 1;
  height: 92rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #111827;
  border: 1rpx solid #e5e7eb;
  background: #fafbfc;
  box-sizing: border-box;
}

.login-input-inline {
  border: 0;
  background: transparent;
}

.login-placeholder {
  color: #b0b6bf;
}

.login-eye {
  flex: 0 0 auto;
  padding: 0 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 24rpx;
  color: #e93b3d;
}

.login-primary {
  width: 100%;
  margin-top: 12rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
}

.login-error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #b91c1c;
  background: #fef2f2;
  border-left: 6rpx solid #e93b3d;
}

.login-agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 28rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8b9199;
}

.login-checkbox {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  margin-right: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  box-sizing: border-box;
}

.login-checkbox-on {
  background: #e93b3d;
  border-color: #e93b3d;
}

.login-agreement-link {
  color: #e93b3d;
}

.login-dev {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #f1f2f4;
}

.login-dev-toggle {
  font-size: 22rpx;
  color: #b0b6bf;
  text-align: center;
}

.login-dev-hint {
  margin: 16rpx 0;
  font-size: 22rpx;
  color: #9ca3af;
}

/* Signed-in state */
.login-signed {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.login-avatar {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #e93b3d, #f97316);
  border-radius: 50%;
}

.login-signed-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.login-signed-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.login-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

/* Trust row */
.login-foot {
  margin-top: auto;
  padding: 32rpx 40rpx 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: #b0b6bf;
}

.login-foot-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #dcdfe4;
}
