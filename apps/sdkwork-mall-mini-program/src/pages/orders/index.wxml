<view class="page-orders">
  <scroll-view class="orders-tabs" scroll-x>
    <view
      class="orders-tab {{activeTab === item.code ? 'orders-tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="code"
      bindtap="selectTab"
      data-code="{{item.code}}"
    >{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:if="{{error}}" class="mp-error">{{error}}</view>
  <view wx:if="{{!loading && orders.length === 0}}" class="mp-empty">{{emptyText}}</view>

  <view class="orders-list">
    <view class="orders-item" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="mp-flex-between">
        <view class="orders-subject">{{item.subject}}</view>
        <text class="orders-status">{{item.statusText}}</text>
      </view>
      <view class="mp-flex-between orders-meta">
        <text class="mp-muted">{{item.timeText}}</text>
        <text class="mp-price">{{item.totalText}}</text>
      </view>
      <view class="orders-actions">
        <button
          wx:if="{{item.status === 'PENDING_PAYMENT'}}"
          class="mp-btn mp-btn-primary orders-action"
          catchtap="payOrder"
          data-id="{{item.id}}"
        >{{payText}}</button>
        <button
          wx:if="{{item.status === 'PENDING_PAYMENT'}}"
          class="mp-btn mp-btn-ghost orders-action"
          catchtap="cancelOrder"
          data-id="{{item.id}}"
        >{{cancelText}}</button>
        <button
          wx:if="{{item.status === 'PENDING_RECEIPT'}}"
          class="mp-btn mp-btn-primary orders-action"
          catchtap="confirmReceipt"
          data-id="{{item.id}}"
        >{{confirmReceiptText}}</button>
        <button
          wx:if="{{item.status === 'PENDING_RECEIPT' || item.status === 'COMPLETED'}}"
          class="mp-btn mp-btn-ghost orders-action"
          catchtap="goLogistics"
          data-id="{{item.id}}"
        >{{logisticsText}}</button>
        <button class="mp-btn mp-btn-plain orders-action">{{viewDetailText}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{orders.length > 0 && orders.length < total}}" class="mp-loading">{{loadMoreText}}</view>
  <view wx:if="{{orders.length > 0 && orders.length >= total}}" class="mp-loading">{{allShownText}}</view>
</view>
