.orders-tabs {
  background: #fff;
  white-space: nowrap;
  position: sticky;
  top: 0;
  z-index: 5;
}

.orders-tab {
  display: inline-block;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.orders-tab-active {
  color: #e93b3d;
  font-weight: 600;
  border-bottom: 4rpx solid #e93b3d;
}

.orders-list {
  padding: 20rpx 0;
}

.orders-item {
  background: #fff;
  border-radius: 0;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.orders-subject {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.orders-status {
  color: #e93b3d;
  font-size: 26rpx;
  flex-shrink: 0;
}

.orders-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
}

.orders-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.orders-action {
  font-size: 24rpx;
  padding: 8rpx 26rpx;
}

.orders-partner {
  color: #b06a00;
}

/* Status semantics: color is a secondary cue; the label always states it. */
.orders-status-PENDING_PAYMENT { color: #d97706; }
.orders-status-PENDING_SHIPMENT { color: #2563eb; }
.orders-status-PENDING_RECEIPT { color: #7c3aed; }
.orders-status-PAID { color: #2563eb; }
.orders-status-COMPLETED { color: #059669; }
.orders-status-CANCELLED,
.orders-status-REFUNDED,
.orders-status-REFUNDING { color: #6b7280; }
