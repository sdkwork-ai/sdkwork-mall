<view class="page-messages">
  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>
  <view wx:if="{{!loading && rows.length === 0}}" class="mp-empty">{{emptyText}}</view>

  <view class="messages-list">
    <view
      class="messages-row"
      wx:for="{{rows}}"
      wx:key="id"
      bindtap="openRow"
      data-url="{{item.targetUrl}}"
    >
      <view class="messages-icon messages-icon-notice">
        <text>{{item.categoryText}}</text>
      </view>
      <view class="messages-body">
        <view class="messages-title">
          <text wx:if="{{item.unread}}" class="messages-unread" aria-hidden="true">●</text>
          {{item.title}}
        </view>
        <view class="mp-muted messages-summary">{{item.summary}}</view>
        <view wx:if="{{item.timeText}}" class="mp-muted messages-time">{{item.timeText}}</view>
      </view>
      <view class="messages-action">{{viewText}}</view>
    </view>
  </view>

  <view wx:if="{{!loading && rows.length > 0}}" class="mp-muted messages-footnote">{{footnoteText}}</view>
</view>
