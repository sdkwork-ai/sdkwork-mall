<view class="page-category">
  <view class="category-search" bindtap="goSearch">
    <view class="category-search-box">搜索商品</view>
  </view>

  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">重试</button>
  </view>

  <view class="category-layout">
    <scroll-view class="category-rail" scroll-y>
      <view
        class="category-rail-item {{activeRootId === item.id ? 'category-rail-item-active' : ''}}"
        wx:for="{{roots}}"
        wx:key="id"
        bindtap="selectRoot"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view class="category-content" scroll-y bindscrolltolower="loadMore">
      <scroll-view wx:if="{{children.length > 0}}" class="category-children" scroll-x>
        <text
          class="category-child {{activeChildId === '' ? 'category-child-active' : ''}}"
          bindtap="selectChild"
          data-id=""
        >{{allLabel}}</text>
        <text
          class="category-child {{activeChildId === item.id ? 'category-child-active' : ''}}"
          wx:for="{{children}}"
          wx:key="id"
          bindtap="selectChild"
          data-id="{{item.id}}"
        >{{item.name}}</text>
      </scroll-view>

      <view wx:if="{{loading}}" class="mp-loading">加载中...</view>
      <view wx:elif="{{!error && products.length === 0}}" class="mp-empty">该分类暂无商品</view>
      <view wx:else class="category-product-list">
        <view
          class="category-product-row"
          wx:for="{{products}}"
          wx:key="id"
          bindtap="goProduct"
          data-id="{{item.id}}"
        >
          <view class="category-product-image">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
            <text wx:else>SDKWork</text>
          </view>
          <view class="category-product-body">
            <view class="mp-product-title">{{item.title}}</view>
            <view class="mp-product-meta">
              <text class="mp-price">{{item.priceText}}</text>
              <text class="mp-product-sales" wx:if="{{item.sales}}">已售 {{item.sales}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{!hasMore}}" class="mp-loading">已展示全部 {{products.length}} 件商品</view>
        <view wx:elif="{{loadingMore}}" class="mp-loading">加载更多...</view>
      </view>
    </scroll-view>
  </view>
</view>
