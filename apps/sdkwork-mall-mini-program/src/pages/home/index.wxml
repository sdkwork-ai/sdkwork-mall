<view class="page-home">
  <view class="home-search" bindtap="goQuickEntry" data-capability="storefront.mall.search">
    <view class="home-search-box">{{searchPlaceholder}}</view>
  </view>

  <swiper class="home-banner" indicator-dots autoplay circular interval="4200">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="home-banner-item">
        <view class="home-banner-title">{{item.title}}</view>
        <view class="home-banner-sub">{{item.subtitle}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="home-quick">
    <view
      class="home-quick-item"
      wx:for="{{quickEntries}}"
      wx:key="id"
      bindtap="goQuickEntry"
      data-capability="{{item.capability}}"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:if="{{error}}" class="mp-error">{{error}}</view>

  <view wx:if="{{categories.length}}" class="mp-card">
    <view class="mp-card-title">{{categoriesTitle}}</view>
    <view class="home-category-grid">
      <view
        class="home-category-item"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="goCategory"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{seckillOffer}}" class="mp-card">
    <view class="mp-flex-between">
      <view class="mp-flex">
        <text class="home-seckill-title">{{seckillTitle}}</text>
        <text class="home-seckill-countdown">{{seckillCountdown}}</text>
      </view>
      <text class="home-seckill-more">{{seckillOffer.discountText || seckillOngoing}}</text>
    </view>
    <view class="home-seckill-highlight" wx:if="{{seckillOffer.highlight}}">{{seckillOffer.highlight}}</view>
  </view>

  <view wx:if="{{hotProducts.length}}" class="home-products">
    <view class="mp-card-title home-products-title">{{hotTitle}}</view>
    <view class="mp-product-grid">
      <view
        class="mp-product-card"
        wx:for="{{hotProducts}}"
        wx:key="id"
        bindtap="goProduct"
        data-id="{{item.id}}"
      >
        <view class="mp-product-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else>SDKWork</text>
        </view>
        <view class="mp-product-body">
          <view class="mp-product-title">{{item.title}}</view>
          <view class="mp-product-meta">
            <text class="mp-price">{{item.priceText}}</text>
            <text class="mp-product-sales" wx:if="{{item.salesLabel}}">{{item.salesLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
