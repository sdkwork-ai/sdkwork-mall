<view class="page-home">
  <view class="home-search" bindtap="goSearch">
    <view class="home-search-box">{{searchPlaceholder}}</view>
  </view>

  <view class="home-banner" style="border-radius:0!important;" bindtouchstart="onBannerTouchStart" bindtouchend="onBannerTouchEnd">
    <view class="home-banner-track" style="transform: translateX(-{{bannerIndex * 100}}%); border-radius:0!important;">
      <view class="home-banner-slide" style="border-radius:0!important;" wx:for="{{banners}}" wx:key="id">
        <view class="home-banner-item home-banner-{{item.tone}}" style="border-radius:0!important;" bindtap="goBanner" data-id="{{item.id}}">
          <view class="home-banner-title">{{item.title}}</view>
          <view class="home-banner-sub">{{item.subtitle}}</view>
          <view class="home-banner-cta">{{ctaText}}</view>
        </view>
      </view>
    </view>
    <view class="home-banner-dots">
      <view
        wx:for="{{banners}}"
        wx:key="id"
        class="home-banner-dot {{index === bannerIndex ? 'home-banner-dot-active' : ''}}"
        data-index="{{index}}"
        catchtap="onBannerDotTap"
      ></view>
    </view>
  </view>

  <view class="home-quick">
    <view
      class="home-quick-item"
      wx:for="{{quickEntries}}"
      wx:key="id"
      bindtap="goQuickEntry"
      data-id="{{item.id}}"
      data-capability="{{item.capability}}"
    >{{item.label}}</view>
  </view>

  <!-- Skeleton shelves: the hero renders immediately, so the first paint should
       not jump when the product data lands. -->
  <block wx:if="{{loading}}">
    <view class="mp-card home-skeleton">
      <view class="home-skeleton-line home-skeleton-line-title"></view>
      <view class="home-skeleton-grid">
        <view class="home-skeleton-tile" wx:for="{{skeletonTiles}}" wx:key="*this"></view>
      </view>
    </view>
    <view class="home-skeleton-products">
      <view class="home-skeleton-product" wx:for="{{skeletonCards}}" wx:key="*this">
        <view class="home-skeleton-image"></view>
        <view class="home-skeleton-line"></view>
        <view class="home-skeleton-line home-skeleton-line-short"></view>
      </view>
    </view>
  </block>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <!-- A single degraded shelf must not look like a fully loaded page. -->
  <view wx:if="{{!loading && !error && shelfNotice}}" class="mp-card home-partial" aria-role="alert">
    <text class="mp-muted">{{shelfNotice}}</text>
    <button class="mp-btn mp-btn-ghost home-partial-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <!-- A resolved-but-empty storefront must explain itself instead of rendering
       a blank strip under the hero. -->
  <view wx:if="{{!loading && !error && !hasContent}}" class="mp-card home-empty" aria-role="status">
    <view class="home-empty-title">{{emptyTitle}}</view>
    <text class="mp-muted">{{emptyHint}}</text>
    <button class="mp-btn mp-btn-ghost home-empty-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <view wx:if="{{categories.length}}" class="mp-card">
    <view class="mp-card-title">{{categoriesTitle}}</view>
    <view class="home-category-grid">
      <view
        class="home-category-item"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="goCategory"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{seckillOffer}}" class="mp-card" bindtap="goSeckill">
    <view class="mp-flex-between">
      <view class="mp-flex">
        <text class="home-seckill-title">{{seckillTitle}}</text>
        <text class="home-seckill-countdown">{{seckillCountdown}}</text>
      </view>
      <text class="home-seckill-more">{{seckillOffer.discountText || seckillOngoing}}</text>
    </view>
    <view class="home-seckill-highlight" wx:if="{{seckillOffer.highlight}}">{{seckillOffer.highlight}}</view>
  </view>

  <view wx:if="{{shops.length}}" class="mp-card">
    <view class="mp-card-title">{{shopsTitle}}</view>
    <view class="home-shop-grid">
      <view
        class="home-shop-card"
        wx:for="{{shops}}"
        wx:key="id"
        bindtap="goShop"
        data-id="{{item.id}}"
      >
        <view class="home-shop-logo">
          <image wx:if="{{item.logoUrl}}" src="{{item.logoUrl}}" mode="aspectFill" lazy-load />
          <text wx:else>{{item.name}}</text>
        </view>
        <view class="home-shop-body">
          <view class="home-shop-name">{{item.name}}</view>
          <view class="mp-muted" wx:if="{{item.ratingText}}">{{item.ratingText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{footprint.length}}" class="mp-card">
    <view class="mp-card-title">{{footprintTitle}}</view>
    <view class="search-chips">
      <text
        class="search-chip"
        wx:for="{{footprint}}"
        wx:key="id"
        bindtap="goProduct"
        data-id="{{item.id}}"
      >{{item.title}}</text>
    </view>
  </view>

  <view wx:if="{{hotProducts.length}}" class="home-products">
    <view class="home-products-head">
      <view class="mp-card-title home-products-title">{{hotTitle}}</view>
      <view class="home-more" bindtap="goMoreHot">{{moreText}}</view>
    </view>
    <view class="mp-product-grid">
      <view
        class="mp-product-card"
        wx:for="{{hotProducts}}"
        wx:key="id"
        bindtap="goProduct"
        data-id="{{item.id}}"
      >
        <view class="mp-product-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <text wx:else>SDKWork</text>
        </view>
        <view class="mp-product-body">
          <view class="mp-product-title">{{item.title}}</view>
          <view class="mp-product-meta">
            <text class="mp-price">{{item.priceText}}</text>
            <text class="mp-product-sales" wx:if="{{item.salesLabel}}">{{item.salesLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{newProducts.length}}" class="home-products">
    <view class="home-products-head">
      <view class="mp-card-title home-products-title">{{newTitle}}</view>
      <view class="home-more" bindtap="goMoreNew">{{moreText}}</view>
    </view>
    <view class="mp-product-grid">
      <view
        class="mp-product-card"
        wx:for="{{newProducts}}"
        wx:key="id"
        bindtap="goProduct"
        data-id="{{item.id}}"
      >
        <view class="mp-product-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <text wx:else>SDKWork</text>
        </view>
        <view class="mp-product-body">
          <view class="mp-product-title">{{item.title}}</view>
          <view class="mp-product-meta">
            <text class="mp-price">{{item.priceText}}</text>
            <text class="mp-product-sales" wx:if="{{item.salesLabel}}">{{item.salesLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="home-services">
    <view
      class="home-service-item"
      wx:for="{{services}}"
      wx:key="id"
      bindtap="goService"
      data-capability="{{item.capability}}"
    >{{item.label}}</view>
  </view>
</view>
