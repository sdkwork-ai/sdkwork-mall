.page-home {
  padding-bottom: 30rpx;
}

.home-search {
  background: #e93b3d;
  padding: 16rpx 24rpx;
}

.home-search-box {
  background: #fff;
  border-radius: 999rpx;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 14rpx 30rpx;
}

.home-banner {
  height: 240rpx;
  margin: 0;
  /* Square corners are part of the flat storefront; `!important` so a stale or
     platform-injected style cannot round the hero again. */
  border-radius: 0 !important;
  overflow: hidden;
}

.home-banner swiper-item,
.home-banner-item {
  border-radius: 0 !important;
}

.home-banner-item {
  height: 100%;
  background: linear-gradient(135deg, #e93b3d, #f97316);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.home-banner-title {
  font-size: 38rpx;
  font-weight: 700;
}

.home-banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.home-quick {
  display: flex;
  justify-content: space-between;
  margin: 0 0 20rpx 0;
  background: #fff;
  border-radius: 0;
  padding: 24rpx 20rpx;
}

.home-quick-item {
  font-size: 26rpx;
  color: #374151;
  padding: 8rpx 18rpx;
  background: #fef2f2;
  border-radius: 999rpx;
}

.home-category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.home-category-item {
  width: 30%;
  text-align: center;
  background: #f9fafb;
  border-radius: 0;
  padding: 18rpx 0;
  font-size: 26rpx;
  box-sizing: border-box;
}

.home-seckill-title {
  color: #e93b3d;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.home-seckill-countdown {
  background: #e93b3d;
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.home-seckill-more {
  color: #e93b3d;
  font-size: 24rpx;
}

.home-seckill-highlight {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.home-products {
  margin-top: 10rpx;
}

.home-products-title {
  padding: 0 20rpx 20rpx;
}

/* ── Home floors that mirror the H5 home snapshot ── */
.home-shop-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.home-shop-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 48%;
  padding: 14rpx;
  border-radius: 0;
  background: #f9fafb;
}

.home-shop-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fee2e2;
  color: #e93b3d;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-shop-logo image {
  width: 100%;
  height: 100%;
}

.home-shop-body {
  min-width: 0;
}

.home-shop-name {
  font-size: 26rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-services {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 0;
  padding: 24rpx 20rpx;
}

.home-service-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #4b5563;
}

/* Hero poster tones, mirroring the H5 carousel posters. */
.home-banner-brand {
  background: linear-gradient(135deg, #e93b3d, #f97316);
}

.home-banner-ember {
  background: linear-gradient(135deg, #f97316, #f59e0b);
}

.home-banner-teal {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
}

.home-banner-violet {
  background: linear-gradient(135deg, #6d28d9, #8b5cf6);
}