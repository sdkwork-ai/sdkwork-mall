.page-home {
  padding-bottom: 30rpx;
}

.home-search {
  background: #e93b3d;
  padding: 16rpx 24rpx;
}

.home-search-box {
  background: #fff;
  border-radius: 999rpx;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 14rpx 30rpx;
}

.home-banner {
  position: relative;
  /* Poster height mirrors the H5 hero: 58vw of the 750rpx viewport, clamped
     between 384rpx and 512rpx lands on 435rpx at every phone width. */
  height: 435rpx;
  margin: 0;
  overflow: hidden;
  background: #e93b3d;
  /* Square corners are part of the flat storefront; `!important` so a stale or
     platform-injected style cannot round the hero again. */
  border-radius: 0 !important;
}

.home-banner-track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 450ms ease;
}

.home-banner-slide {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  border-radius: 0 !important;
}

.home-banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  display: flex;
  justify-content: center;
  gap: 0;
}

/* Bar-style indicator, mirroring the H5 hero dots: a slim pill bar inside a
   square hit area; the active bar widens. The hit area is 44rpx so the dots stay
   tappable on a phone. */
.home-banner-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.home-banner-dot::before {
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  content: "";
  transition: width 0.2s ease, background-color 0.2s ease;
}

.home-banner-dot-active::before {
  width: 28rpx;
  background: #ffffff;
}

.home-banner-item {
  position: relative;
  height: 100%;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  /* Flat poster: one solid brand field per slide, no gradient — the H5 hero
     rule (`.sdk-h5-hero-slide`). */
  background: #e93b3d;
  isolation: isolate;
}

/* Poster ornaments: flat translucent discs, decorative only. */
.home-banner-item::before,
.home-banner-item::after {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.home-banner-item::before {
  top: -70rpx;
  right: -30rpx;
  width: 170rpx;
  height: 170rpx;
  background: rgba(255, 255, 255, 0.08);
}

.home-banner-item::after {
  right: 50rpx;
  bottom: -90rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
}

.home-banner-title {
  position: relative;
  z-index: 1;
  max-width: 10em;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: 0.01em;
  text-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.22);
}

.home-banner-sub {
  position: relative;
  z-index: 1;
  max-width: 20em;
  font-size: 26rpx;
  line-height: 1.45;
  opacity: 0.92;
  margin-top: 12rpx;
}

.home-banner-cta {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 600;
}

.home-quick {
  display: flex;
  justify-content: space-between;
  margin: 0 0 20rpx 0;
  background: #fff;
  border-radius: 0;
  padding: 24rpx 20rpx;
}

.home-quick-item {
  font-size: 26rpx;
  color: #374151;
  padding: 8rpx 18rpx;
  background: #fef2f2;
  border-radius: 999rpx;
}

.home-category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.home-category-item {
  /* Four per row: the default dataset seeds eight first-level categories, so a
     fresh install fills two rows with no ragged trailing row. */
  width: calc((100% - 48rpx) / 4);
  text-align: center;
  background: #f9fafb;
  border-radius: 0;
  padding: 18rpx 0;
  font-size: 26rpx;
  box-sizing: border-box;
}

.home-seckill-title {
  color: #e93b3d;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.home-seckill-countdown {
  background: #e93b3d;
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.home-seckill-more {
  color: #e93b3d;
  font-size: 24rpx;
}

.home-seckill-highlight {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.home-products {
  margin-top: 10rpx;
}

.home-products-title {
  padding: 0 20rpx 20rpx;
}

/* ── Home floors that mirror the H5 home snapshot ── */
.home-shop-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.home-shop-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 48%;
  padding: 14rpx;
  border-radius: 0;
  background: #f9fafb;
}

.home-shop-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fee2e2;
  color: #e93b3d;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-shop-logo image {
  width: 100%;
  height: 100%;
}

.home-shop-body {
  min-width: 0;
}

.home-shop-name {
  font-size: 26rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-services {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 0;
  padding: 24rpx 20rpx;
}

.home-service-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #4b5563;
}

/* Hero poster tones — flat solid fields mirroring the H5 hero posters
   (`.sdk-h5-hero-slide` / `--teal` / `--ember` / `--violet`); `brand` keeps the
   mini-program storefront red. */
.home-banner-brand {
  background: #e93b3d;
}

.home-banner-ember {
  background: #c2410c;
}

.home-banner-teal {
  background: #0f766e;
}

.home-banner-violet {
  background: #5b21b6;
}

/* Empty storefront: explains the blank page and offers a retry. */
.home-partial {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.home-partial-retry {
  flex-shrink: 0;
}

.home-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

.home-empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.home-empty-retry {
  margin-top: 12rpx;
}
