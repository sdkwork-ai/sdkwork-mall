<view class="page-chat">
  <view wx:if="{{message}}" class="mp-error chat-error">
    <text>{{message}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">重试</button>
  </view>

  <scroll-view class="chat-stream" scroll-y scroll-into-view="{{scrollInto}}">
    <view wx:if="{{messages.length === 0}}" class="mp-empty chat-empty">{{emptyText}}</view>
    <view
      class="chat-bubble-row chat-bubble-{{item.role === 'user' ? 'right' : 'left'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
    >
      <view class="chat-bubble {{item.role === 'user' ? 'chat-bubble-user' : 'chat-bubble-agent'}}">
        {{item.content}}
      </view>
    </view>
  </scroll-view>

  <view class="chat-composer">
    <text class="chat-image-btn" bindtap="sendImage" aria-label="{{imageText}}">{{imageText}}</text>
    <input
      class="chat-composer-input"
      placeholder="{{placeholder}}"
      maxlength="500"
      value="{{draft}}"
      confirm-type="send"
      bindinput="onDraftInput"
      bindconfirm="send"
    />
    <button class="mp-btn mp-btn-primary chat-composer-send" disabled="{{busy || !draft}}" bindtap="send">{{sendText}}</button>
  </view>
</view>
