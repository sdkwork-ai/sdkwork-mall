.review-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.review-row:last-child {
  border-bottom: none;
}

.review-body {
  flex: 1;
  min-width: 0;
}

.review-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.review-action {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}

.review-actions {
  display: flex;
  justify-content: center;
  padding-top: 24rpx;
}

.review-note {
  text-align: center;
  margin-top: 8rpx;
}
