.page-checkout {
  padding-bottom: 210rpx;
}

.checkout-count {
  padding: 20rpx 30rpx 0;
}

/* 商品清单：买家在付款前必须看到买了什么 */
.checkout-goods {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.checkout-goods:last-child {
  border-bottom: 0;
}

.checkout-goods-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  background: #f4f5f7;
}

.checkout-goods-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 22rpx;
}

.checkout-goods-body {
  flex: 1;
  min-width: 0;
}

.checkout-goods-title {
  font-size: 26rpx;
  color: #1f2937;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.checkout-address {
  border: 1rpx solid #e5e7eb;
  border-radius: 0;
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.checkout-address-active {
  border-color: #e93b3d;
  background: #fef2f2;
}

.checkout-default {
  color: #e93b3d;
  font-size: 22rpx;
  border: 1rpx solid #e93b3d;
  border-radius: 0;
  padding: 0 8rpx;
  margin-left: 10rpx;
}

.checkout-coupon {
  border: 1rpx solid #e5e7eb;
  border-radius: 0;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
}

.checkout-deduct {
  padding: 16rpx 0;
  font-size: 26rpx;
}

.checkout-remark {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 0;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.checkout-invoice-types {
  margin-top: 16rpx;
}

.checkout-invoice-type {
  padding: 10rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 26rpx;
  color: #4b5563;
}

.checkout-invoice-type-on {
  border-color: #e93b3d;
  color: #e93b3d;
  background: #fef2f2;
}

.checkout-giftcard-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkout-giftcard-input {
  flex: 1;
  border: 1rpx solid #e5e7eb;
  border-radius: 0;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.checkout-giftcard-error {
  margin-top: 8rpx;
  color: #e93b3d;
  font-size: 24rpx;
}

.checkout-payable {
  font-size: 34rpx;
}

.checkout-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f3f4f6;
}

.checkout-submit {
  width: 100%;
  font-size: 30rpx;
}

.checkout-trust {
  text-align: center;
  color: #9ca3af;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}
