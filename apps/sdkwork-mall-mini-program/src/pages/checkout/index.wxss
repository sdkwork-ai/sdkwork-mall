.page-checkout {
  padding-bottom: 160rpx;
}

.checkout-count {
  padding: 20rpx 30rpx 0;
}

.checkout-address {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.checkout-address-active {
  border-color: #e93b3d;
  background: #fef2f2;
}

.checkout-default {
  color: #e93b3d;
  font-size: 22rpx;
  border: 1rpx solid #e93b3d;
  border-radius: 6rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
}

.checkout-coupon {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
}

.checkout-deduct {
  padding: 16rpx 0;
  font-size: 26rpx;
}

.checkout-remark {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.checkout-payable {
  font-size: 34rpx;
}

.checkout-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f3f4f6;
}

.checkout-submit {
  width: 100%;
  font-size: 30rpx;
}
