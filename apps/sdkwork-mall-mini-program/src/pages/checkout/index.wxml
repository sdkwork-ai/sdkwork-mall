<view class="page-checkout">
  <view wx:if="{{loading}}" class="mp-loading">{{loadingText}}</view>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
  </view>

  <block wx:if="{{!loading}}">
    <view wx:if="{{itemCount}}" class="mp-muted checkout-count">{{selectedCountText}}</view>

    <view class="mp-card">
      <view class="mp-flex-between">
        <view class="mp-card-title">{{addressTitle}}</view>
        <text class="mp-muted" bindtap="goAddress">{{addressManage}}</text>
      </view>
      <view wx:if="{{addresses.length === 0}}" class="mp-empty">{{addressEmpty}}</view>
      <view
        class="checkout-address {{selectedAddressId === item.id ? 'checkout-address-active' : ''}}"
        wx:for="{{addresses}}"
        wx:key="id"
        bindtap="selectAddress"
        data-id="{{item.id}}"
      >
        <view>{{item.receiverName}} {{item.receiverPhone}} <text wx:if="{{item.isDefault}}" class="checkout-default">{{defaultLabel}}</text></view>
        <view class="mp-muted">{{item.addressLine}}</view>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{deliveryTitle}}</view>
      <view
        class="checkout-address {{deliveryMethodCode === item.code ? 'checkout-address-active' : ''}}"
        wx:for="{{deliveryMethods}}"
        wx:key="code"
        bindtap="selectDeliveryMethod"
        data-code="{{item.code}}"
      >
        <view>{{item.label}}</view>
        <view class="mp-muted">{{item.description}}</view>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{couponTitle}}</view>
      <view
        class="checkout-coupon {{selectedCouponId === '' ? 'checkout-address-active' : ''}}"
        bindtap="selectCoupon"
        data-id=""
      >{{couponNone}}</view>
      <view
        class="checkout-coupon {{selectedCouponId === item.id ? 'checkout-address-active' : ''}}"
        wx:for="{{coupons}}"
        wx:key="id"
        bindtap="selectCoupon"
        data-id="{{item.id}}"
      >
        <view>{{item.title}} <text wx:if="{{item.discountAmountCny}}" class="mp-price">¥{{item.discountAmountCny}}</text></view>
        <view class="mp-muted" wx:if="{{item.thresholdText}}">{{item.thresholdText}}</view>
      </view>
      <view wx:if="{{coupons.length === 0}}" class="mp-muted">{{couponEmpty}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{deductTitle}}</view>
      <view class="mp-flex-between checkout-deduct" bindtap="toggleWallet">
        <text>{{walletLabel}}</text>
        <view class="cart-checkbox {{useWallet ? 'cart-checkbox-on' : ''}}" />
      </view>
      <view class="mp-flex-between checkout-deduct" bindtap="togglePoints">
        <text>{{pointsLabel}}</text>
        <view class="cart-checkbox {{usePoints ? 'cart-checkbox-on' : ''}}" />
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{giftCardTitle}}</view>
      <view wx:if="{{giftCardApplied}}" class="mp-flex-between checkout-deduct">
        <text>{{giftCardAppliedText}}</text>
        <text class="mp-muted" bindtap="removeGiftCard">{{giftCardRemove}}</text>
      </view>
      <view wx:else class="checkout-giftcard-row">
        <input
          class="checkout-giftcard-input"
          placeholder="{{giftCardPlaceholder}}"
          value="{{giftCardCode}}"
          bindinput="onGiftCardInput"
        />
        <button class="mp-btn mp-btn-ghost" bindtap="applyGiftCard">{{giftCardApply}}</button>
      </view>
      <view wx:if="{{giftCardError}}" class="checkout-giftcard-error">{{giftCardError}}</view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">{{remarkTitle}}</view>
      <textarea
        class="checkout-remark"
        placeholder="{{remarkPlaceholder}}"
        maxlength="200"
        value="{{buyerRemark}}"
        bindinput="onRemarkInput"
      />
    </view>

    <view class="mp-card">
      <view class="mp-flex-between checkout-deduct" bindtap="toggleInvoice">
        <text>{{invoiceNeed}}</text>
        <view class="cart-checkbox {{needInvoice ? 'cart-checkbox-on' : ''}}" />
      </view>
      <block wx:if="{{needInvoice}}">
        <view class="mp-flex checkout-invoice-types">
          <view
            class="checkout-invoice-type {{invoiceTitleType === 'personal' ? 'checkout-invoice-type-on' : ''}}"
            bindtap="selectInvoiceTitleType"
            data-type="personal"
          >{{invoicePersonal}}</view>
          <view
            class="checkout-invoice-type {{invoiceTitleType === 'company' ? 'checkout-invoice-type-on' : ''}}"
            bindtap="selectInvoiceTitleType"
            data-type="company"
          >{{invoiceCompany}}</view>
        </view>
        <view class="mp-field">
          <text class="mp-field-label">{{invoiceTitleLabel}}</text>
          <input placeholder="{{invoiceTitlePlaceholder}}" value="{{invoiceTitle}}" bindinput="onInvoiceTitleInput" />
        </view>
        <view class="mp-field" wx:if="{{invoiceTitleType === 'company'}}">
          <text class="mp-field-label">{{invoiceTaxLabel}}</text>
          <input placeholder="{{invoiceTaxPlaceholder}}" value="{{invoiceTaxNumber}}" bindinput="onInvoiceTaxNumberInput" />
        </view>
        <view class="mp-field">
          <text class="mp-field-label">{{invoiceEmailLabel}}</text>
          <input placeholder="{{invoiceEmailPlaceholder}}" value="{{invoiceEmail}}" bindinput="onInvoiceEmailInput" />
        </view>
      </block>
    </view>

    <view class="mp-card">
      <view class="mp-flex-between" wx:if="{{originalAmountText}}">
        <text>{{summaryGoods}}</text>
        <text>{{originalAmountText}}</text>
      </view>
      <view class="mp-flex-between" wx:if="{{discountAmountText}}">
        <text>{{summaryDiscount}}</text>
        <text>-{{discountAmountText}}</text>
      </view>
      <view class="mp-flex-between">
        <text>{{summaryPayable}}</text>
        <text class="mp-price checkout-payable">{{payableText}}</text>
      </view>
      <view wx:if="{{quoteError}}" class="mp-error">
        <text>{{quoteError}}</text>
        <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">{{retryText}}</button>
      </view>
    </view>

    <view class="checkout-footer">
      <button class="mp-btn mp-btn-primary checkout-submit" disabled="{{busy}}" bindtap="submit">
        {{busy ? submittingText : submitText}}
      </button>
    </view>
  </block>

  <view wx:if="{{toast}}" class="mp-toast">{{toast}}</view>
</view>
