.wallet-hero {
  display: flex;
  background: linear-gradient(135deg, #e93b3d, #f06b3e);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.wallet-hero-item {
  flex: 1;
}

.wallet-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.wallet-amount {
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.ledger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-body {
  flex: 1;
  margin-right: 16rpx;
}

.ledger-summary {
  font-size: 28rpx;
  font-weight: 600;
}

.wallet-note {
  margin-top: 24rpx;
  text-align: center;
}
