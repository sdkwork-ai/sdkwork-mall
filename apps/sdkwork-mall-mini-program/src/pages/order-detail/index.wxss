.detail-hero {
  background: linear-gradient(135deg, #e93b3d, #f97316);
  color: #fff;
  padding: 44rpx 40rpx;
}

.detail-status {
  font-size: 40rpx;
  font-weight: 700;
}

.detail-subject {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.detail-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d1d5db;
  flex-shrink: 0;
}

.detail-item-image image {
  width: 100%;
  height: 100%;
}

.detail-item-body {
  flex: 1;
  margin-left: 18rpx;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.detail-meta text:first-child {
  color: #6b7280;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 30rpx 0;
  padding: 0 30rpx;
}
