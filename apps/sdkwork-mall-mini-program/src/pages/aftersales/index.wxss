.aftersales-order-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.aftersales-order-row input {
  flex: 1;
}

.aftersales-order-action {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  margin: 0;
}

.aftersales-picker {
  padding: 14rpx 0;
  font-size: 28rpx;
}

.aftersales-submit {
  margin-top: 24rpx;
}

.aftersales-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f3f4f6;
  padding: 20rpx 0;
}

.aftersales-row:last-child {
  border-bottom: none;
}

.aftersales-body {
  flex: 1;
  margin-right: 16rpx;
}

.aftersales-title {
  font-size: 28rpx;
  font-weight: 600;
}

.aftersales-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.aftersales-cancel {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  margin: 0;
}

.aftersales-evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.aftersales-evidence-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #e5e7eb;
  background: #f4f5f7;
}

.aftersales-evidence-image {
  width: 100%;
  height: 100%;
}

.aftersales-evidence-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.55);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.aftersales-evidence-state {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  padding: 4rpx 0;
  text-align: center;
  color: #fff;
  background: rgba(17, 24, 39, 0.55);
}

.aftersales-evidence-add {
  aspect-ratio: 1;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #9ca3af;
  background: #fff;
}
