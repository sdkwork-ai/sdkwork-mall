<view class="page-aftersales">
  <view wx:if="{{loading}}" class="mp-loading">加载售后...</view>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">重试</button>
  </view>

  <block wx:if="{{!loading}}">
    <view class="mp-card">
      <view class="mp-card-title">申请售后</view>
      <view class="mp-field">
        <text class="mp-field-label">订单号</text>
        <view class="aftersales-order-row">
          <input
            disabled="{{orderLoaded}}"
            placeholder="输入需要售后的订单号"
            value="{{orderId}}"
            bindinput="onOrderIdInput"
          />
          <button
            wx:if="{{!orderLoaded}}"
            class="mp-btn mp-btn-ghost aftersales-order-action"
            disabled="{{loadingOrder}}"
            bindtap="loadOrder"
          >{{loadingOrder ? '读取中' : '读取订单'}}</button>
          <button
            wx:else
            class="mp-btn mp-btn-ghost aftersales-order-action"
            disabled="{{busy}}"
            bindtap="clearOrder"
          >更换</button>
        </view>
        <view wx:if="{{orderSummary}}" class="mp-muted">{{orderSummary}}</view>
      </view>

      <view class="mp-field">
        <text class="mp-field-label">售后类型</text>
        <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="aftersales-picker">{{types[typeIndex].label}}</view>
        </picker>
      </view>

      <view class="mp-field">
        <text class="mp-field-label">售后原因</text>
        <picker range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="onReasonChange">
          <view class="aftersales-picker">{{reasons[reasonIndex].label}}</view>
        </picker>
      </view>

      <view class="mp-field">
        <text class="mp-field-label">问题描述（选填）</text>
        <textarea
          maxlength="200"
          placeholder="补充描述有助于加快审核"
          value="{{description}}"
          bindinput="onDescriptionInput"
        />
      </view>

      <view class="mp-field">
        <text class="mp-field-label">售后金额（元）</text>
        <input type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" />
      </view>

      <view class="mp-field">
        <text class="mp-field-label">凭证上传（可选，最多 6 张）</text>
        <view class="aftersales-evidence-grid">
          <view class="aftersales-evidence-item" wx:for="{{evidence}}" wx:key="id">
            <image class="aftersales-evidence-image" mode="aspectFill" src="{{item.tempPath}}" />
            <view class="aftersales-evidence-remove" bindtap="removeEvidence" data-id="{{item.id}}">×</view>
            <view class="aftersales-evidence-state">{{item.state === 'uploading' ? '上传中...' : '已上传'}}</view>
          </view>
          <view
            wx:if="{{evidence.length < 6}}"
            class="aftersales-evidence-add"
            bindtap="chooseEvidence"
          >+</view>
        </view>
      </view>

      <button
        class="mp-btn mp-btn-primary aftersales-submit"
        disabled="{{busy || loadingOrder}}"
        bindtap="submit"
      >{{busy ? '提交中...' : '提交申请'}}</button>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">售后记录</view>
      <view wx:if="{{requests.length === 0}}" class="mp-empty">暂无售后记录</view>
      <view class="aftersales-row" wx:for="{{requests}}" wx:key="id">
        <view class="aftersales-body">
          <view class="aftersales-title">
            {{item.typeLabel}}
            <text wx:if="{{item.afterSalesNo}}" class="mp-muted"> {{item.afterSalesNo}}</text>
          </view>
          <view class="mp-muted">订单 {{item.orderId}}</view>
          <view class="mp-muted">¥{{item.requestedAmount || '0.00'}}</view>
          <button
            wx:if="{{item.returnable && returnFormRequestId !== item.id}}"
            class="mp-btn mp-btn-plain aftersales-return-entry"
            bindtap="openReturnForm"
            data-id="{{item.id}}"
          >填写退货物流</button>
          <view wx:if="{{returnFormRequestId === item.id}}" class="mp-field aftersales-return-form">
            <text class="mp-field-label">物流公司</text>
            <picker
              range="{{returnCarriers}}"
              range-key="name"
              value="{{returnCarrierIndex}}"
              bindchange="onReturnCarrierChange"
            >
              <view class="aftersales-picker">{{returnCarriers[returnCarrierIndex].name}}</view>
            </picker>
            <text class="mp-field-label">退货物流单号</text>
            <input
              placeholder="请输入快递单号"
              value="{{returnTrackingNo}}"
              bindinput="onReturnTrackingInput"
            />
            <view class="aftersales-return-actions">
              <button
                class="mp-btn mp-btn-primary"
                disabled="{{returnBusy}}"
                bindtap="submitReturnShipment"
              >{{returnBusy ? '提交中...' : '提交'}}</button>
              <button
                class="mp-btn mp-btn-ghost"
                disabled="{{returnBusy}}"
                bindtap="closeReturnForm"
              >取消</button>
            </view>
          </view>
          <button
            class="mp-btn mp-btn-plain aftersales-progress-entry"
            bindtap="toggleProgress"
            data-id="{{item.id}}"
          >{{progressRequestId === item.id ? '收起进度' : '处理进度'}}</button>
          <view wx:if="{{progressRequestId === item.id}}" class="aftersales-progress">
            <view wx:if="{{progressLoading}}" class="mp-muted">加载进度...</view>
            <view wx:elif="{{progressEvents.length === 0}}" class="mp-empty">暂无进度</view>
            <view wx:for="{{progressEvents}}" wx:key="index" class="aftersales-progress-item">
              <view class="aftersales-progress-action">{{item.action}}</view>
              <view wx:if="{{item.at}}" class="mp-muted">{{item.at}}</view>
            </view>
          </view>
        </view>
        <view class="aftersales-side">
          <text class="mp-muted">{{item.statusLabel}}</text>
          <button
            wx:if="{{item.revokable}}"
            class="mp-btn mp-btn-plain aftersales-cancel"
            disabled="{{busy}}"
            bindtap="cancelRequest"
            data-id="{{item.id}}"
          >撤销</button>
        </view>
      </view>
    </view>
  </block>
</view>
