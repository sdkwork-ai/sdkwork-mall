.activity-hero {
  background: linear-gradient(135deg, #e93b3d, #f06b3e);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.activity-hero.activity-ended {
  opacity: 0.6;
}

.activity-hero.activity-upcoming {
  opacity: 0.85;
}

.activity-hero-type {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.activity-hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.activity-hero-highlight {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.activity-hero-window {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.75;
}

.activity-description {
  font-size: 28rpx;
  line-height: 1.7;
  color: #374151;
}
