<view class="page-shop">
  <view wx:if="{{loading}}" class="mp-loading">加载店铺...</view>
  <view wx:if="{{error}}" class="mp-error">
    <text>{{error}}</text>
    <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retry">重试</button>
  </view>
  <view wx:if="{{!loading && !error && !shop}}" class="mp-empty">店铺不存在或已关闭</view>

  <block wx:if="{{!loading && shop}}">
    <view class="shop-hero">
      <image wx:if="{{shop.logoUrl}}" class="shop-logo" src="{{shop.logoUrl}}" mode="aspectFill" lazy-load />
      <view wx:else class="shop-logo shop-logo-fallback">店</view>
      <view class="shop-hero-body">
        <view class="shop-name">{{shop.name}}</view>
        <view class="mp-muted" wx:if="{{shop.ratingText}}">评分 {{shop.ratingText}}</view>
      </view>
    </view>

    <view class="mp-card">
      <view class="mp-card-title">店铺商品</view>
      <view wx:if="{{shop.productsUnavailable && shop.products.length === 0}}" class="mp-error">
        <text>商品加载失败</text>
        <button class="mp-btn mp-btn-ghost mp-error-retry" bindtap="retryProducts">重试</button>
      </view>
      <view wx:elif="{{shop.products.length === 0}}" class="mp-empty">暂无在售商品</view>
      <view class="shop-product-grid">
        <view
          class="shop-product-card"
          wx:for="{{shop.products}}"
          wx:key="id"
          bindtap="goProduct"
          data-id="{{item.id}}"
        >
          <image wx:if="{{item.imageUrl}}" class="shop-product-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <view wx:else class="shop-product-image shop-product-fallback">SDKWork</view>
          <view class="shop-product-title">{{item.title}}</view>
          <view class="mp-flex-between">
            <text class="mp-price">{{item.priceText}}</text>
            <text class="mp-muted" wx:if="{{item.salesText}}">已售 {{item.salesText}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="mp-loading">加载更多商品...</view>
      <view wx:elif="{{shop.products.length > 0 && !shop.productsHasMore}}" class="mp-muted shop-end">没有更多商品了</view>
    </view>
  </block>
</view>
