.shop-hero {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f4f5f7;
  flex-shrink: 0;
}

.shop-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e93b3d;
  font-size: 44rpx;
  font-weight: 700;
}

.shop-hero-body {
  margin-left: 24rpx;
}

.shop-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.shop-product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.shop-product-card {
  width: calc((100% - 16rpx) / 2);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
}

.shop-product-image {
  width: 100%;
  height: 320rpx;
  background: #f4f5f7;
}

.shop-product-title {
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 16rpx 4rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.shop-product-card .mp-price {
  padding: 0 16rpx;
}
