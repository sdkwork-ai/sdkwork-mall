<view class="page-gift-cards">
  <view class="mp-card">
    <view class="mp-card-title">功能说明</view>
    <view class="gift-line" wx:for="{{notice}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="mp-card">
    <view class="mp-card-title">可用资产</view>
    <view class="mp-muted gift-empty">暂无礼品卡与红包，兑换记录将在合约上线后同步。</view>
    <view class="gift-actions">
      <button class="mp-btn mp-btn-primary" bindtap="goWallet">查看我的钱包</button>
    </view>
  </view>
</view>
