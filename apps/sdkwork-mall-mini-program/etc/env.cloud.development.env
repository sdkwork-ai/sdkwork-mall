# The mini program is a packaged surface: a phone cannot reach the dev local
# gateway (127.0.0.1). Point the development profile at the device-reachable dev
# gateway; local simulator runs may override through the DevTools console global
# __SDKWORK_MALL_MP_RUNTIME_ENV__.
SDKWORK_MALL_MINI_PROGRAM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_IAM_APP_API_BASE_URL=https://api-dev.sdkwork.com
