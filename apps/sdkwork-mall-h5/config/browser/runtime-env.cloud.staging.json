{
  "environment": "staging",
  "deploymentProfile": "cloud",
  "profileId": "cloud.staging",
  "runtimeTarget": "browser",
  "browserOriginMode": "cross-origin",
  "configProfile": "dev",
  "buildMode": "development",
  "deploymentMode": "web",
  "appKey": "sdkwork-mall-h5",
  "auth": {
    "tokenManagerMode": "appbase-global",
    "tokenStorage": "browser-session",
    "accessTokenHeader": "Access-Token",
    "authTokenHeader": "Authorization",
    "refreshEnabled": true
  },
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
      "zh-CN",
      "en-US"
    ],
    "fallbackLocale": "en-US"
  },
  "cloudApiBaseUrls": [
    "https://api-staging.sdkwork.com"
  ],
  "appApiBaseUrl": "https://api-staging.sdkwork.com",
  "backendApiBaseUrl": "https://api-staging.sdkwork.com",
  "driveAppApiBaseUrl": "https://api-staging.sdkwork.com",
  "appbaseAppApiBaseUrl": "https://api-staging.sdkwork.com",
  "deployAppApiBaseUrl": "https://api-staging.sdkwork.com",
  "openApiBaseUrl": "https://api-staging.sdkwork.com",
  "sdkBaseUrl": "https://api-staging.sdkwork.com"
}
