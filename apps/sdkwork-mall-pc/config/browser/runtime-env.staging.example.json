{
  "environment": "staging",
  "deploymentProfile": "cloud",
  "profileId": "cloud.staging",
  "runtimeTarget": "browser",
  "browserOriginMode": "same-origin",
  "configProfile": "staging",
  "buildMode": "staging",
  "deploymentMode": "web",
  "appKey": "sdkwork-mall-pc",
  "sdkBaseUrls": {
    "sdkBaseUrl": "https://api-staging.sdkwork.com",
    "appApiBaseUrl": "https://api-staging.sdkwork.com/app/v3/api",
    "backendApiBaseUrl": "https://api-staging.sdkwork.com/backend/v3/api",
    "dependencySdkBaseUrls": {
      "sdkwork-iam-app-sdk": {
        "appApiBaseUrl": "https://api-staging.sdkwork.com/app/v3/api"
      },
      "sdkwork-iam-backend-sdk": {
        "backendApiBaseUrl": "https://api-staging.sdkwork.com/backend/v3/api"
      }
    }
  },
  "auth": {
    "tokenManagerMode": "appbase-global",
    "tokenStorage": "browser-session",
    "accessTokenHeader": "Access-Token",
    "authTokenHeader": "Authorization",
    "refreshEnabled": true
  },
  "i18n": {
    "defaultLocale": "zh-CN",
    "supportedLocales": [
      "zh-CN",
      "en-US"
    ],
    "fallbackLocale": "en-US"
  },
  "publicRuntime": {
    "runtimeEnvFile": "/runtime-env.json",
    "appApiBaseUrl": "https://api-staging.sdkwork.com/app/v3/api",
    "backendApiBaseUrl": "https://api-staging.sdkwork.com/backend/v3/api"
  },
  "appApiBaseUrl": "/",
  "backendApiBaseUrl": "/",
  "driveAppApiBaseUrl": "/",
  "appbaseAppApiBaseUrl": "/",
  "deployAppApiBaseUrl": "/",
  "openApiBaseUrl": "/",
  "sdkBaseUrl": "/"
}
